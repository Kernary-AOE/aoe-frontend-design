{
  "mcpServers": {
    "prime-wiki": {
      "command": "bun",
      "args": [
        "run",
        "${ENGINE_ROOT}/packages/mcp-server-core/src/index.ts"
      ],
      "env": {
        "PRIME_DIR": "${CORPUS_ROOT}/compiled-v3-final"
      }
    },
    "prime-design": {
      "command": "bun",
      "args": [
        "run",
        "${DOMAIN_ROOT}/mcp/src/server.ts"
      ],
      "env": {
        "PRIME_DIR": "${CORPUS_ROOT}/compiled-v3-final"
      }
    }
  }
}
