rule AccessChangeConsequenceDisclosure {
  id: "@community/rule-access-change-consequence-disclosure"
  version: "1.0.0"

  domain: frontend-design

  _meta: {
    license: "GPL-3.0"
    license-provenance: "legacy-backfill"
  }

  severity: block

  statement: "When a user's access level changes (role assignment, permission upgrade or downgrade, account access modification), the UI must display a before/after delta and explicitly label any irreversible consequences before the user confirms."

  applies-when: "Implementing role assignment, permission upgrade or downgrade, or account access modification flows."

  verify-by: "Confirm UI shows a summary of what will change and explicitly labels destructive or irreversible effects. An 'Are you sure?' prompt without a change summary is insufficient."

  rationale: "Silent access changes can cause data loss or privilege escalation; informed confirmation prevents accidental destructive actions. Showing the delta (what is being added and removed) transforms a blind confirmation into an informed one."

  related: [
    @community/rule-auth-flow-reversibility,
    @community/principle-error-prevention-and-recovery,
    @community/rule-explicit-trade-off-disclosure,
  ]
}
