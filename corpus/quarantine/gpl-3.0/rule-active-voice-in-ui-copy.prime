rule ActiveVoiceInUiCopy {
  id: "@community/rule-active-voice-in-ui-copy"
  version: "1.0.0"

  domain: frontend-design

  _meta: {
    license: "GPL-3.0"
    license-provenance: "legacy-backfill"
  }

  severity: warning

  statement: "Write all UI labels, status messages, confirmations, and instructions in active voice with an explicit subject (user or system). Passive voice constructions are prohibited."

  applies-when: "Writing any button label, status message, confirmation dialog, or instruction in a UI."

  verify-by: "Identify passive constructions ('will be saved', 'has been submitted', 'was deleted') and rewrite with an explicit active subject."

  anti-pattern: [
    "'Changes will be saved' → 'We'll save your changes'",
    "'Form has been submitted' → 'Your form was submitted'",
    "'File will be deleted' → 'Delete this file permanently?'",
  ]

  use-instead: "Active voice is shorter, clearer, and communicates who is doing what. 'Save changes' is unambiguous; 'Changes will be saved' raises the question of when and by whom."

  related: [
    @community/rule-actionable-error-messages,
    @community/rule-consistent-product-terminology,
    @community/rule-culturally-neutral-copy,
  ]
}
