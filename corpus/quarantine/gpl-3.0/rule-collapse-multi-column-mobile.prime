rule CollapseMultiColumnMobile {
  id: "@community/rule-collapse-multi-column-mobile"
  version: "1.0.0"

  label: "Collapse Multi-Column Layouts on Small Screens"
  domain: frontend-design

  _meta: {
    license: "GPL-3.0"
    license-provenance: "legacy-backfill"
  }


  statement: "Any multi-column layout (grid-template-columns with 2+ columns, or flex-direction: row with multiple siblings) must reflow to a single column at narrow viewports — preferably mobile-first via grid-template-columns: repeat(1, 1fr) base with wider breakpoints layered on top."

  rationale: "Multi-column grids on small screens cause horizontal overflow or force horizontal scrolling, degrading usability. Single-column flow at narrow widths is the universally expected reading pattern on phone-class devices."

  applies-when: "any component or layout section rendered at viewport width < 640px using 2+ columns"

  verify-by: "Resize browser to 375px; confirm no horizontal scrollbar and all columns stack vertically"

  code: """
    /* Mobile-first collapse pattern */
    .layout-grid {
      display: grid;
      grid-template-columns: 1fr;          /* single column base */
      gap: 16px;
    }
    @media (min-width: 640px) {
      .layout-grid { grid-template-columns: repeat(2, 1fr); }
    }
    @media (min-width: 1024px) {
      .layout-grid { grid-template-columns: repeat(3, 1fr); }
    }

    /* Flex row that collapses */
    .flex-row-collapse {
      display: flex;
      flex-direction: column;
      gap: 16px;
    }
    @media (min-width: 768px) {
      .flex-row-collapse { flex-direction: row; }
    }
  """

  severity: error

  related: [
    @community/constraint-mobile-touch-target-44px,
    @community/rule-mobile-first,
    @community/fact-8pt-grid-system,
  ]
}
