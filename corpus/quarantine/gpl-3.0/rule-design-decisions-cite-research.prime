rule DesignDecisionsCiteResearch {
  id: "@community/rule-design-decisions-cite-research"
  version: "1.0.0"

  domain: frontend-design

  _meta: {
    license: "GPL-3.0"
    license-provenance: "legacy-backfill"
  }

  severity: warning

  statement: "When usability studies, interviews, surveys, or analytics exist, every design proposal must explicitly reference the supporting evidence — naming at least one data source (test, interview finding, funnel metric) in its rationale."

  applies-when: "Proposing or reviewing any design change when research artifacts or analytics are available."

  verify-by: "Check that the design rationale names at least one data source. A proposal with no evidence citation when evidence exists must be sent back for research review."

  rationale: "Evidence-backed decisions reduce revisiting settled questions and align teams around shared observations. Unevidenced decisions in an evidence-rich environment waste prior investment and reintroduce solved problems."

  related: [
    @community/rule-align-changes-to-findings,
    @community/anti-pattern-cherry-picking-evidence,
    @community/principle-evidence-not-aesthetics,
  ]
}
