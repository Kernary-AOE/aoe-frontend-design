rule NoHeavyShadowsPerComponent {
  id: "@community/rule-no-heavy-shadows-per-component"
  version: "1.0.0"

  domain: frontend-design

  _meta: {
    license: "GPL-3.0"
    license-provenance: "legacy-backfill"
  }


  description: "Components must not define their own novel box-shadow values — all shadow styles must come from the design token system's elevation scale."

  claim: "Bespoke box-shadow declarations per component are forbidden; use only tokens from the elevation/shadow token layer (e.g., --shadow-sm, --shadow-md, --shadow-lg)."

  severity: medium

  rationale: "Proliferating unique shadow values across components creates visual inconsistency — five cards with five different drop shadows look undesigned. A token-based elevation scale (typically 3–5 levels) ensures consistent spatial layering and simplifies dark-mode adaptation."

  forbidden: [
    "box-shadow: 0 12px 40px rgba(0,0,0,0.25) — raw value outside token system",
    "Matching shadow color to component accent color — creates brand-inconsistent lighting",
    "Multiple shadow layers per component (more than 2) without token backing",
  ]

  correct: [
    "box-shadow: var(--shadow-md) — token-backed",
    "box-shadow: var(--shadow-card) — semantic token",
  ]

  related: [
    @community/anti-pattern-magic-numbers,
    @community/rule-consistent-design-token-scale,
    @community/rule-no-new-visual-primitives,
  ]
}
