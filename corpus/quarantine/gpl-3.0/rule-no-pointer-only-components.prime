rule NoPointerOnlyComponents {
  id: "@community/rule-no-pointer-only-components"
  version: "1.0.0"

  domain: frontend-design

  _meta: {
    license: "GPL-3.0"
    license-provenance: "legacy-backfill"
  }


  description: "Custom interactive components must be fully operable by keyboard alone, not only by mouse or touch — any component that requires a pointer device to activate or dismiss is non-compliant."

  claim: "Custom dropdowns, sliders, carousels, and drag interfaces must each have a complete keyboard interaction pattern (Tab, Enter, Space, Arrow keys, Escape as appropriate)."

  severity: critical

  keyboard-patterns: [
    "Dropdown / menu: Tab into trigger, Enter/Space to open, Arrow keys to navigate items, Enter to select, Escape to close",
    "Dialog/modal: Tab into, focus trapped inside, Escape to close",
    "Slider: Tab into, Arrow keys to increment/decrement, Home/End for min/max",
    "Drag-and-drop: keyboard alternative via 'Reorder mode' with Arrow keys",
    "Date picker: Arrow keys to navigate days, Enter to select, Escape to dismiss",
  ]

  related: [
    @community/rule-keyboard-accessible,
    @community/anti-pattern-hover-only-interaction,
    @community/anti-pattern-breaking-keyboard-flow,
    @community/counter-example-div-onclick-dropdown,
    @community/counter-example-tooltip-hover-only,
    @community/example-radix-dialog,
    @community/rule-semantic-html-for-interactive-elements,
  ]
}
