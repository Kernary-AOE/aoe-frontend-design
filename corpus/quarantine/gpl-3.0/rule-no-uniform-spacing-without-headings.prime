rule NoUniformSpacingWithoutHeadings {
  id: "@community/rule-no-uniform-spacing-without-headings"
  version: "1.0.0"

  applies-to: @community/type-html-artifact

  domain: frontend-design

  _meta: {
    license: "GPL-3.0"
    license-provenance: "legacy-backfill"
  }


  description: "Unrelated content blocks must not use identical spacing between them when no heading or visual separator distinguishes their boundaries — spacing variation is itself a structural signal, and uniform spacing creates an undifferentiated wall of content."

  claim: "Spacing between unrelated sections MUST be visually larger than spacing within a section (at least 1.5× the intra-section gap), OR a heading / separator must be present — applying the same gap everywhere removes the spatial hierarchy that guides eye movement."

  severity: warning

  rationale: "Gestalt proximity: elements spaced equally appear to belong to the same group. When every block has identical spacing, nothing signals 'this is a new topic'. Readers lose context about section boundaries."

  examples: {
    violation: "A page with a hero, features, testimonials, and pricing all separated by the exact same 48px margin, with no section headings — visually indistinguishable from a single long block."
    correct: "Features section uses 16px between feature cards (intra-group), but 80px above the testimonials section (inter-group), and each section has a visible h2 heading."
  }

  spacing-ratio: "Inter-section gap ≥ 1.5× intra-section gap. A common scale: 16px within a section, 48–80px between sections."

  remediation: [
    "Audit margins: identify cases where consecutive sections share identical top/bottom margins.",
    "Either add section headings (h2/h3) or increase the gap between unrelated blocks.",
    "Use a spacing scale (8, 16, 24, 32, 48, 64, 80, 96) and reserve the larger values for inter-section gaps.",
  ]

  related: [
    @community/rule-spacing-rhythm,
    @community/rule-heading-hierarchy-logical,
    @community/check-spacing-rhythm,
  ]
}
