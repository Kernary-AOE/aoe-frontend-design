anti-pattern AiSlopAesthetics {
  id: "@community/anti-pattern-ai-slop-aesthetics"
  version: "1.0.0"

  label: "AI Slop Aesthetics"
  domain: frontend-design

  _meta: {
    license: "MIT AND Apache-2.0"
    license-provenance: "legacy-backfill"
  }


  description: "Generic, predictable visual choices — Inter/Roboto/Arial fonts, purple gradients on white backgrounds, context-free cookie-cutter components — that mark a UI as unthinkingly AI-generated because they represent the statistical average of training data."

  trap: "These are the path of least resistance for generative models: neutral colors, generous whitespace, rounded corners, familiar layouts all score safe ratings in RLHF. Safety optimization produces mediocrity by design. The output is indistinguishable from every other AI-generated UI — it lacks character, context-specificity, and memorability."

  remediation: [
    "Commit to a bold, context-specific aesthetic direction with a persona brief before writing any code.",
    "Choose distinctive font pairing (display serif + humanist sans) instead of Inter.",
    "Build OKLCH palette from an intentional brand hue — avoid 240–300° range.",
    "Apply persona-driven border radius (0px for brutalist, 2-4px for precise, 8-12px for friendly).",
  ]

  related: [
    @impeccable/anti-pattern-ai-slop-palette,
    @community/anti-pattern-ai-generated-ui,
    @impeccable/principle-distinctiveness,
  ]
}
