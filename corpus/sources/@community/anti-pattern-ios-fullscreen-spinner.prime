anti-pattern IosFullscreenSpinner {
  id: "@community/anti-pattern-ios-fullscreen-spinner"
  version: "1.0.0"

  label: "iOS Full-Screen Blocking Spinner"
  domain: frontend-design

  _meta: {
    license: "Apache-2.0"
    license-provenance: "package-authorship-claim"
  }


  description: "Showing a full-screen ProgressView (or activity indicator overlay) that blocks all interaction while content loads. The spinner occupies the entire viewport with no contextual information, leaving the user with nothing to look at and no sense of progress."

  why-bad: "Full-screen spinners make the app feel frozen and unresponsive. They provide zero content context, give no indication of how long the wait will be, and prevent any interaction (e.g., navigating away or reading cached content). Skeleton views that mirror the final layout reduce perceived load time and improve user confidence. Apple HIG source: Rules 7.8 and 8.2; Anti-Pattern #3."

  instead-do: "Use skeleton/placeholder views that match the final content layout (same card shapes, row heights, image placeholders). For known-duration operations, use a determinate ProgressView. For inline refreshes (pull-to-refresh, pagination), use a small inline progress indicator scoped to the updating region."

  notes: [
    "Why it's tempting: trivial to implement (ProgressView().frame(maxWidth: .infinity, maxHeight: .infinity)) and it prevents duplicate taps.",
    "Skeleton views can be constructed with rounded rectangles at the expected text/image positions, animated with shimmer.",
    "If you must block interaction (e.g., irreversible payment), scope the blocking overlay to the action button area only, not the full screen.",
    "Apple HIG source: Rule 7.8 — Progress Indicators; Rule 8.2 — Loading; Anti-Pattern #3.",
  ]

  related: [
    @community/anti-pattern-no-loading-state,
    @community/rule-ios-launch-screen-match,
    @community/rule-mobile-first,
  ]
}
