anti-pattern IosNonDismissableModal {
  id: "@community/anti-pattern-ios-non-dismissable-modal"
  version: "1.0.0"

  label: "iOS Non-Dismissable Modal (Trapped User)"
  domain: frontend-design

  _meta: {
    license: "MIT AND Apache-2.0"
    license-provenance: "legacy-backfill"
  }


  description: "Presenting a sheet or full-screen modal with no cancel button and swipe-to-dismiss disabled, trapping the user until they complete a forced step."

  why-bad: "Users feel trapped and cannot exit to other app features or use the back button. There is always an interruption scenario (phone call, wrong tap) where the user needs to abandon the flow. iOS sheet dismissal is expected behavior and disabling it without a Cancel button violates the HIG — Apple HIG Rule 8.4 and Anti-Pattern #11."

  instead-do: "Always provide at least one dismiss path: a Cancel/Close button in the toolbar, or preserve the default swipe-to-dismiss behavior on sheets (.presentationDetents). If the task requires confirmation before exit, present a .confirmationDialog asking 'Discard changes?' rather than blocking dismiss entirely."

  notes: [
    "The only legitimate use of .interactiveDismissDisabled(true) is when the user has unsaved changes — and even then, a confirmationDialog must be shown on attempted dismiss.",
    "Apple HIG source: Rule 8.4 — Modality, Use Sparingly; Anti-Pattern #11.",
  ]

  related: [
    @community/anti-pattern-ios-stacked-modals,
    @community/pattern-ios-sheet-presentation,
    @community/rule-ios-alerts-critical-only,
  ]
}
