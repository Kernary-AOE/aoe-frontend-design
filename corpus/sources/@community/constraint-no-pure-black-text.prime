constraint NoPureBlackText {
  id: "@community/constraint-no-pure-black-text"
  version: "1.0.0"

  target: ["body text", "paragraph color", "default foreground in long-form reading contexts"]
  severity: high
  domain: visual-design

  _meta: {
    license: "Apache-2.0"
    license-provenance: "package-authorship-claim"
  }


  description: "Body and paragraph text must never use pure black (#000000 / oklch(0% 0 0)). Pure black on near-white induces excessive contrast and visual fatigue; use a soft near-black such as oklch(18% 0.04 var(--hue))."

  values: [
    {
      forbidden: "#000000",
      forbidden-equivalent: "oklch(0% 0 0)",
    }
    {
      forbidden: "rgb(0, 0, 0)",
      forbidden-equivalent: "hsl(0 0% 0%)",
    }
  ]

  rationale: "Pure black against pure white is a halation pattern: the eye over-adjusts to the maximum-contrast edge, causing chromatic blur and reading fatigue. Editorial publications (NYT, Atlantic, FT) all use a desaturated near-black around L=15–20 to soften the glare while preserving WCAG AA contrast against off-white backgrounds."

  exceptions: [
    "Logos and brand marks where pure black is part of the identity.",
    "Pure-data UI tokens (e.g., terminal text on a black-themed code editor where intent is high-contrast monospace).",
    "Print stylesheets (where reflectance, not emission, governs perception).",
  ]

  approved-alternatives: [
    "oklch(18% 0.04 var(--hue)) — soft near-black, hue-aware",
    "oklch(20% 0.02 250) — neutral cool near-black",
    "#1a1a1a / #1c1c1e — Apple system label (dark)",
    "#171717 — Tailwind neutral-900",
  ]

  enforcement: "Stylelint custom rule rejecting `color: #000` / `color: black` on prose selectors (`p`, `article *`, `[role=main]`, `.prose *`). PR review checks tokens for `--text` resolving to pure black."

  related: [
    @community/constraint-no-pure-white-bg,
    @community/check-color-oklch-required,
    @community/term-oklch,
  ]
}
