fact AnthropicBrandTypography {
  id: "@community/fact-anthropic-brand-typography"
  version: "1.0.0"

  domain: frontend-design

  _meta: {
    license: "MIT AND Apache-2.0"
    license-provenance: "legacy-backfill"
  }


  description: "Anthropic's official brand typography uses Poppins (Arial fallback) for headings at 24pt and above, and Lora (Georgia fallback) for all body text — making it an intentional serif/sans-serif split that grounds brand communication in warmth and authority."

  statement: "Anthropic brand design mandates Poppins (weight 600–700) for all heading levels at 24pt+ with Arial as system fallback, and Lora (weight 400) for body text at 16–18px with Georgia as system fallback; the pairing communicates intellectual credibility via the serif body against contemporary geometric display headings."

  confidence: strong
  source: [
    "Anthropic brand-guidelines skill, Typography section (github.com/anthropics/skills)",
    "Anthropic Smart Font Application feature description",
  ]

  applies-to: [
    "any artifact built for or on behalf of Anthropic",
    "claude.ai interface components",
    "Anthropic marketing pages and documentation",
  ]

  quantitative: {
    heading-font: "Poppins",
    heading-fallback: "Arial, sans-serif",
    heading-min-size: "24pt",
    heading-weight: "600–700",
    body-font: "Lora",
    body-fallback: "Georgia, serif",
    body-size: "16–18px",
    body-weight: "400",
  }

  counter-conditions: [
    "Third-party integrations referencing Anthropic API may use their own brand typography.",
    "Documentation sites (docs.anthropic.com) may shift to a more neutral technical font for code-heavy content.",
  ]

  related: [
    @community/rule-font-blacklist-applied,
    @community/category-typography-scale,
    @community/taxonomy-typography-roles,
  ]
}
