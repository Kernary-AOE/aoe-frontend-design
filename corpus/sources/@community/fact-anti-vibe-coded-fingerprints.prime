fact AntiVibeCodedFingerprints {
  id: "@community/fact-anti-vibe-coded-fingerprints"
  version: "1.0.0"

  domain: frontend-design

  _meta: {
    license: "Apache-2.0"
    license-provenance: "package-authorship-claim"
  }


  description: "Vibe-coded UIs — built by describing aesthetic feeling to an AI without explicit design constraints — reliably produce a small set of recognizable fingerprints: saturated neon on dark backgrounds, glassmorphism cards, bounce-eased micro-animations, and oversized gradient hero sections."

  statement: "Vibe-coding produces its own predictable aesthetic: dark background + neon accent (#00FFAA, #FF00FF, or cyan #06B6D4) + frosted glass panels + every card animated with spring-back bounce + hero with radial gradient blob decoration. These are the 'vibe-code fingerprints' distinct from the Inter/purple slop pattern but equally recognizable as undesigned — just undesigned in the 'cool tech startup' direction rather than the 'generic SaaS' direction."

  counter-conditions: [
    "When a persona brief specifies the vibe before coding begins, some vibe-code aesthetics are appropriate (e.g. neon on dark for a gaming product with an editorial brief).",
    "The problem is not the aesthetic itself but arriving at it through statistical inference rather than design intent.",
  ]

  source: [
    "Prime Wiki A/B v4/v5 test data — empirical output sampling, Raw builds with dark mode prompts",
  ]

  related: [
    @impeccable/anti-pattern-ai-slop-palette,
    @community/anti-pattern-ai-generated-ui,
    @community/fact-ai-fingerprint-detection,
  ]
}
