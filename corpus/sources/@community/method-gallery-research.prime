method GalleryResearch {
  id: "@community/method-gallery-research"
  version: "1.0.0"

  label: "Gallery Research Methodology"
  domain: frontend-design

  _meta: {
    license: "Apache-2.0"
    license-provenance: "package-authorship-claim"
  }


  description: "A 6-step protocol for extracting reusable design patterns from gallery sites (land-book.com, godly.website, mobbin.com) — replacing passive browsing with structured pattern extraction that produces actionable tokens."

  steps: [
    {
      name: "Pick exactly 3 sites"
      do: "Select one you find beautiful, one that surprised you, one from the relevant category (landing / dashboard / editorial). Start at land-book.com filtered by project industry."
      check: "Maximum 3 tabs open. More dilutes attention and produces nothing actionable."
    }
    {
      name: "Screenshot ONE section per site"
      do: "Capture only one section — hero (most craft), pricing (structural decisions), or features (component patterns). Use browser screenshot or Cmd+Shift+4."
      check: "One screenshot per site. Full-page scrolls dilute attention and extract nothing."
    }
    {
      name: "Extract the memory hook"
      do: "Close the screenshot. Wait 30 seconds. Write in one sentence the ONE visual detail you still remember — a color contrast ratio, an unusual type size relationship, an unexpected grid break, a scroll motion."
      check: "One sentence with a concrete visual observation. 'Nice hero' is not a memory hook."
    }
    {
      name: "Name the pattern"
      do: "Give the remembered detail a reusable name specific enough to be recreatable. Include geometry, direction, or values."
      check: "Good: 'hero diagonal gradient wash at 145deg'. Bad: 'nice hero', 'clean layout', 'good typography'."
    }
    {
      name: "Extract CSS tokens"
      do: "Look at the screenshot and extract approximate measurable values: OKLCH color (warm/cool, chroma level), type size ratio (display:body), padding amount, border radius (0–2px / 6–10px / 16px+), shadow presence."
      check: "Approximations are sufficient: '~40px section padding, muted warm background, 0px radius cards' is actionable."
    }
    {
      name: "Cross-reference with persona"
      do: "Ask: which of the 6 design personas does this align with? Brutalist · Editorial · Tokyo Minimal · Warm Institutional · Dense Pragmatist · Swiss Modernist. Note if it's idiosyncratic or hybrid."
      check: "Persona alignment connects gallery inspiration to the persona system used in production."
    }
  ]

  anti-patterns: [
    "Opening 15+ tabs and closing them all — inspiration without extraction is procrastination",
    "Saving to a design folder you never reopen — extraction happens now, not later",
    "Copying a layout — patterns transfer, compositions don't; always rebuild from extracted tokens",
    "Relying on memory — write the pattern name before closing the tab",
  ]

  sources: [
    "land-book.com (website gallery)",
    "godly.website (curated web design)",
    "mobbin.com (mobile app screenshots)",
  ]

  related: [
    @impeccable/principle-distinctiveness,
    @community/anti-pattern-ai-generated-ui,
    @community/method-anti-ai-slop-checklist,
  ]
}
