method PersonaFingerprintTest {
  id: "@community/method-persona-fingerprint-test"
  version: "1.0.0"

  label: "Persona Fingerprint Test"
  domain: frontend-design

  _meta: {
    license: "Apache-2.0"
    license-provenance: "package-authorship-claim"
  }


  description: "A rapid 3-question audit to verify that a generated UI has the correct visual fingerprint for its declared persona — ensuring the persona brief was actually enacted rather than just named."

  steps: [
    {
      question: "If someone named the persona after seeing this UI (without being told), would they name the correct one?"
      pass: "Yes — the visual language is unmistakably the declared persona."
      fail: "No — could be any persona or none. The brief was not enacted."
    }
    {
      question: "Name the 3 most distinctive non-default choices in this design."
      pass: "Three specific, non-generic answers: e.g. 'zero border radius, Syne 800 uppercase labels, hot red-orange accent' for Brutalist."
      fail: "Answers are vague ('clean spacing', 'nice typography') or describe defaults rather than choices."
    }
    {
      question: "Does the visual hierarchy match the persona's density signature?"
      pass: "Dense Pragmatist = compact (28-32px row heights, 12px font). Editorial = generous (64px nav, 48px card padding). Values match."
      fail: "Density is uniform across personas — no calibration to the declared persona's signature."
    }
  ]

  scoring: "3/3 = persona correctly enacted. 2/3 = partial — revisit the failing signal category. 0-1/3 = persona not enacted, restart from persona brief."

  related: [
    @community/pattern-persona-component-mapping,
    @impeccable/persona-brutalist,
    @impeccable/persona-editorial,
  ]
}
