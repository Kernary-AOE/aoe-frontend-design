pattern AirbnbSignatureMarketing {
  id: "@community/pattern-airbnb-signature-marketing"
  version: "1.0.0"

  label: "Airbnb Signature Marketing Patterns"
  domain: frontend-design

  _meta: {
    license: "Apache-2.0"
    license-provenance: "package-authorship-claim"
  }


  description: "The eight signature design patterns that define Airbnb's visual language: three-layer shadow lift, Rausch Red as singular accent, warm near-black, circular navigation controls, generous radius scale, Cereal VF weights, palette-token system, and photography-first listing cards."

  problem: "Airbnb's brand warmth and approachability are achieved through a very specific set of decisions that work as a system — copying individual elements without the others produces off-brand results."

  solution: "Apply all eight patterns together: graduated shadow elevation, #ff385c only for CTAs/logo, #222222 near-black, 50% circular controls, 20/32/50% radius scale, Cereal VF 500–700, palette-token variables, and image-dominant listing cards."

  structure: """
    /* Three-layer shadow lift */
    .airbnb-card {
      box-shadow:
        rgba(0,0,0,0.02) 0px 0px 0px 1px,      /* border ring */
        rgba(0,0,0,0.04) 0px 2px 6px,            /* ambient */
        rgba(0,0,0,0.1)  0px 4px 8px;            /* primary lift */
    }

    /* Rausch Red — singular CTA/logo accent only */
    :root {
      --color-rausch: #ff385c;
    }

    /* Warm near-black — never pure #000 */
    :root {
      --color-text-primary: #222222;
    }

    /* Circular controls */
    .airbnb-circle-control {
      border-radius: 50%;
    }

    /* Radius scale */
    :root {
      --radius-card:    20px;
      --radius-large:   32px;
      --radius-control: 50%;
    }
  """

  notes: [
    "1. Three-layer shadow: rgba(0,0,0,0.02) border-ring + rgba(0,0,0,0.04) ambient + rgba(0,0,0,0.1) primary lift.",
    "2. Rausch Red #ff385c: logo, primary CTAs, brand moments only — never backgrounds, never decoration.",
    "3. Warm near-black #222222: never pure #000000; warmth is subtle but essential to the cozy magazine feel.",
    "4. Circular (50%) nav controls: carousel prev/next, avatar, heart/wishlist — organic tap targets.",
    "5. Generous radius: 20px cards + 32px large elements + 50% controls — nothing sharp.",
    "6. Cereal VF weights 500–700: no thin (300/400) weights on headings; confident-warm.",
    "7. Palette-token system (--palette-*): systematic color management with Luxe and Plus tier tokens.",
    "8. Photography-first listing cards: images occupy top half with rounded corners; details below.",
  ]

  related: [
    @community/persona-airbnb,
  ]
}
