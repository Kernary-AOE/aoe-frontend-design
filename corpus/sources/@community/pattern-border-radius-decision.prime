pattern BorderRadiusDecision {
  id: "@community/pattern-border-radius-decision"
  version: "1.0.0"

  label: "Border Radius Decision Checklist"
  domain: frontend-design

  _meta: {
    license: "Apache-2.0"
    license-provenance: "package-authorship-claim"
  }


  problem: "Developers ship border-radius values without answering the underlying design intent question. The result is radius decisions that conflict with product personality or create visual inconsistency across component types."

  solution: "Before shipping, run a five-question checklist that forces articulation of product personality first, then validates radius consistency, interactive-element parity, nested-element adherence, and radius variation. If question 1 cannot be answered, stop and define personality before choosing any radius value."

  notes: [
    "Decision checklist — answer all five before shipping:",
    "  1. What is the product's intended personality? (professional, playful, editorial, friendly)",
    "  2. Does the radius value match that personality?",
    "  3. Are all interactive elements on the same radius scale?",
    "  4. Are nested elements following the subtraction formula (inner = outer - padding)?",
    "  5. Is there at least one context where radius decreases (e.g., inner chips, tags inside cards)?",
    "Radius is downstream of brand personality — not a starting point. If question 1 cannot be answered, define personality first.",
    "A/B evidence: Prime builds with persona-driven radius scored higher on 'looks like it was designed intentionally' vs Raw builds using 16–32px uniformly.",
  ]

  related: [
    @impeccable/persona-vercel-clean,
    @impeccable/persona-magazine-editorial,
    @community/anti-pattern-generic-saas-blue,
    @community/check-focus-visible,
  ]
}
