pattern CspStrict {
  id: "@community/pattern-csp-strict"
  version: "1.0.0"

  label: "Strict Content Security Policy"
  domain: security

  _meta: {
    license: "Apache-2.0"
    license-provenance: "package-authorship-claim"
  }


  description: "A Content-Security-Policy header that allowlists ONLY the origins your app actually loads — blocks XSS by refusing inline scripts and unauthorized origins."

  problem: "Browsers will execute any script the page contains by default. XSS injections (stored or reflected) become RCE in the user's session. Without CSP, every input vector becomes an attack surface — a single reflected parameter becomes a session-hijacking vector."

  solution: "Set CSP header restricting script-src, style-src, img-src, connect-src, frame-ancestors. Use nonce-based scripting (no 'unsafe-inline'). Use 'self' + explicit CDN domains, never wildcards. Start in report-only mode to catch violations before enforcement."

  structure: """
    # nginx / reverse-proxy header
    Content-Security-Policy:
      default-src 'self';
      script-src  'self' 'nonce-{random}' https://cdn.example.com;
      style-src   'self' 'nonce-{random}';
      img-src     'self' data: https:;
      font-src    'self' https://fonts.gstatic.com;
      connect-src 'self' https://api.example.com wss://api.example.com;
      media-src   'none';
      object-src  'none';
      frame-src   'none';
      frame-ancestors 'none';
      base-uri    'self';
      form-action 'self';
      upgrade-insecure-requests;
      report-uri  /csp-report;

    # Per-request nonce generation (Node.js)
    const nonce = crypto.randomBytes(16).toString('base64');
    res.setHeader('Content-Security-Policy',
      `script-src 'self' 'nonce-${nonce}'; style-src 'self' 'nonce-${nonce}'; ...`
    );

    # Usage in HTML
    <script nonce="${nonce}" src="/app.js"></script>
    <style  nonce="${nonce}">/* critical CSS */</style>

    # Report-only mode for initial rollout (collect violations without blocking)
    Content-Security-Policy-Report-Only: default-src 'self'; report-uri /csp-report;
  """

  notes: [
    "Generate per-request nonce with crypto.randomBytes(16).toString('base64') — never reuse the same nonce across requests",
    "Avoid 'unsafe-inline' on script-src — a single 'unsafe-inline' defeats the entire nonce strategy",
    "'unsafe-eval' must also be absent — it permits dynamically constructed functions (new Function(), eval())",
    "Add report-uri or report-to endpoint to collect real-user violation telemetry before flipping to enforce mode",
    "Test with Google's CSP Evaluator (https://csp-evaluator.withgoogle.com) before deploying",
    "frame-ancestors 'none' is equivalent to X-Frame-Options: DENY — use both for legacy browser compatibility",
  ]

  related: [
    @community/check-content-security-policy,
    @community/anti-pattern-eval-user-input,
    @community/principle-owasp-injection,
  ]
}
