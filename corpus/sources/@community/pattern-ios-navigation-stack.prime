pattern IosNavigationStack {
  id: "@community/pattern-ios-navigation-stack"
  version: "1.0.0"

  label: "iOS NavigationStack for Hierarchical Content"
  domain: frontend-design

  _meta: {
    license: "MIT AND Apache-2.0"
    license-provenance: "legacy-backfill"
  }


  description: "Use NavigationStack with a NavigationPath binding and .navigationDestination(for:) modifiers for type-safe, programmatically-navigable push/pop hierarchies in iOS 16+."

  problem: "NavigationView (deprecated) provides no programmatic navigation API, making deep-linking and state restoration difficult. Custom navigation containers duplicate system behavior without swipe-back gesture support."

  solution: "Wrap root content in NavigationStack(path: $navigationPath). Use .navigationDestination(for: ItemType.self) to define push destinations. Control navigation programmatically by appending to or removing from navigationPath. For deep links, populate the path at app launch from the incoming URL or notification."

  notes: [
    "Use-when: content has parent-child hierarchy requiring drill-down (list → detail → sub-detail).",
    "Use-when: programmatic navigation or deep-linking is required.",
    "NavigationSplitView is preferred on iPad/Mac; NavigationStack is the correct choice for iPhone.",
    "Requires iOS 16+.",
    "Apple HIG source: Rule 2.5 — Use NavigationStack for Hierarchical Content.",
  ]

  related: [
    @community/pattern-ios-large-title-nav,
    @community/rule-ios-preserve-navigation-state,
    @community/rule-ios-no-override-swipe-back,
    @community/constraint-mobile-touch-target-44px,
    @community/check-touch-target-min,
    @community/check-mobile-first,
    @community/check-focus-visible,
  ]
}
