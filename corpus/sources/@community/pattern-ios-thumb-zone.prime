pattern IosThumbZone {
  id: "@community/pattern-ios-thumb-zone"
  version: "1.0.0"

  label: "iOS Thumb Zone for Primary Actions"
  domain: frontend-design

  _meta: {
    license: "MIT AND Apache-2.0"
    license-provenance: "legacy-backfill"
  }


  description: "Place primary call-to-action controls in the lower half of the screen (thumb zone) where the thumb naturally rests in a one-handed grip, keeping destructive or infrequent actions in the upper, harder-to-reach zones."

  problem: "Primary action buttons placed at the top of tall iPhone screens require the user to shift their grip or use a second hand, increasing effort and error rate for the most common action."

  solution: "Position the primary CTA as a full-width or large bottom button above the home indicator safe area (bottom of the safe area). Secondary or destructive actions (Delete, Settings) may live in the navigation bar at the top. Tab bars at the bottom double as both navigation and thumb-zone access to primary destinations."

  notes: [
    "Verify: hold phone in one-handed grip; confirm the primary action is reachable without shifting grip.",
    "On iPhone Pro Max (430pt): the natural one-handed thumb zone extends roughly from y=60% of screen height down to the home indicator.",
    "Apple HIG source: Rule 1.3 — Primary Actions in the Thumb Zone.",
  ]

  related: [
    @community/constraint-ios-touch-target-44pt,
    @community/rule-ios-safe-area-insets,
    @community/pattern-ios-tab-bar-top-level,
    @community/constraint-mobile-touch-target-44px,
    @community/check-touch-target-min,
    @community/check-mobile-first,
    @community/check-focus-visible,
  ]
}
