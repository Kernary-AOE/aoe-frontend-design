pattern IosWidgetsGlanceable {
  id: "@community/pattern-ios-widgets-glanceable"
  version: "1.0.0"

  label: "iOS Widgets for Glanceable Data"
  domain: frontend-design

  _meta: {
    license: "MIT AND Apache-2.0"
    license-provenance: "legacy-backfill"
  }


  description: "Provide WidgetKit widgets for frequently-checked app data surfaced on the home screen or lock screen; use AppIntent-powered Button/Toggle within widgets for one-tap interactive actions in iOS 17+."

  problem: "Frequently-checked app data (step count, task count, score, timer) requires opening the full app just to glance at a single number, adding unnecessary friction."

  solution: "Implement a WidgetExtension using WidgetKit. Define a TimelineProvider that supplies timeline entries. Build widget views for small, medium, and large widget families. For iOS 17+, add interactive AppIntent actions using Button or Toggle inside the widget view so users can trigger a primary action (Start Workout, Complete Task) without opening the app."

  notes: [
    "Use-when: app has data users check multiple times per day (timer, step count, task count, sports score).",
    "Use-when: a frequently-performed action benefits from one-tap access from the home screen.",
    "Keep widget layouts glanceable: 3–5 pieces of information maximum for the small size.",
    "Apple HIG source: Rule 10.1 — Widgets for Glanceable Data.",
  ]

  related: [
    @community/pattern-ios-live-activities,
    @community/pattern-ios-app-shortcuts-siri,
    @community/rule-ios-spotlight-indexing,
    @community/constraint-mobile-touch-target-44px,
    @community/check-touch-target-min,
    @community/check-mobile-first,
    @community/check-focus-visible,
  ]
}
