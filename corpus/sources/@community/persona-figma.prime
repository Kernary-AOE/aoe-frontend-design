persona Figma {
  id: "@community/persona-figma"
  version: "1.0.0"

  school: figma
  domain: visual-design

  _meta: {
    license: "Apache-2.0"
    license-provenance: "package-authorship-claim"
  }


  description: "Achromatic tool-chrome aesthetic: figmaSans variable font with granular weight stops (320–700), strict black #000000 and white #ffffff interface shell hosting explosively colorful product-output heroes, pill and circle button geometry evoking a tool palette, and dashed focus outlines that mirror the product's own selection UI."

  implies: {
    font: {
      display: "figmaSans variable (fallbacks: figmaSans Fallback, SF Pro Display, system-ui, helvetica) — 86px / 400 / line-height 1.00 / letter-spacing -1.72px for hero"
      body: "figmaSans at weight 320–340 (lighter than typical 400) for ethereal airy reading; OpenType 'kern' enabled globally"
      monospace: "figmaMono variable (fallbacks: figmaMono Fallback, SF Mono, menlo) — uppercase labels with +0.54–0.6px tracking"
    }
    color: {
      temperature: "neutral"
      palette: "pure black #000000 text and borders, pure white #ffffff background, glass dark rgba(0,0,0,0.08) subtle overlay, glass white rgba(255,255,255,0.16) frosted on colored hero — zero chromatic colors in chrome"
      background: "#ffffff pure white (chrome only; hero sections use vibrant multi-stop gradient: electric green → bright yellow → deep purple → hot pink)"
    }
    density: "open-airy — body at 320–340 weight feels lighter than standard 400, 8px base spacing with fractional 4.5px values, max container up to 1920px"
    layout: "centered 1920px max-width, hero with full-bleed vibrant gradient hosting product screenshot, feature grids with colorful product previews, pill tabs and circle icon buttons throughout"
    imagery: "colorful product screenshots and user-generated Figma files as hero art — the chrome is the frame, the content is the painting; no stock photography"
    motion: "creative playground — frosted glass transitions, gradient hue shifts in hero, 200-300ms ease-out; no scroll-jacking; motion reinforces the tool-as-canvas metaphor"
  }

  compatible: ["vercel-clean", "swiss-modernist", "brutalist"]
  conflicts: ["warm-institutional", "magazine-editorial", "notion-warm", "stripe-fintech"]

  example-brands: [
    "Figma",
  ]

  notes: [
    "figmaSans weight stops 320/330/340/450/480/540/700 — never standard 400/500/600. Hierarchy through micro-weight differences: 330 vs 340 is nearly imperceptible but structurally meaningful. Using standard weights misses the entire typographic system.",
    "Monochrome chrome + rainbow content is the defining move: the interface has zero chromatic color; all vibrancy lives in product screenshots and hero gradients. A consistent brand color in the chrome would collapse this persona.",
    "Dashed 2px focus outlines reference the Figma editor's selection handles — the website's UI mirrors the product's UI. Using solid or rounded focus rings breaks the meta-reference.",
    "Negative letter-spacing on body (-0.1 to -0.26px) and aggressive display compression (-1.72px at 86px, -0.96px at 64px) — nearly as universal as Apple's negative tracking but expressed through variable-weight rather than optical sizing.",
    "Use for design tools, creative tools, or prosumer products that showcase colorful user-generated output while keeping chrome neutral. Avoid when the product needs a consistent brand color — achromatic chrome reads corporate without the rainbow contrast to redeem it.",
    "Distinct from persona-vercel-clean: Figma is achromatic-chrome-plus-rainbow-content with tool-palette geometry (pill + circle buttons); vercel-clean is dark-first with a single neon accent and card-based layout.",
  ]

  composition: {
    must-include: [
      @impeccable/template-easing-curves,
      @community/fact-variable-font-axes,
      @community/rule-opentype-features-on,
    ]
    must-avoid: [
      @impeccable/persona-warm-institutional,
      @impeccable/persona-magazine-editorial,
    ]
    typography-required: {
      display: "figmaSans variable"
      weight-stops: "320/330/340/450/480/540/700 (never standard 400/500/600)"
      tracking: "-1.72px at 86px display"
    }
    color-required: {
      background: "#ffffff (chrome only)"
      chrome-colors: "black #000000 and white #ffffff only — zero chromatic in chrome"
      hero: "vibrant gradient: electric green → bright yellow → deep purple → hot pink"
    }
    motion-prescriptions: [
      @impeccable/template-easing-curves,
      @community/pattern-gradient-mesh-engine,
    ]
  }

  related: [
    @impeccable/persona-vercel-clean,
    @impeccable/template-oklch-palette,
    @impeccable/template-easing-curves,
    @community/principle-typography-hierarchy,
    @community/check-line-length-optimal,
    @community/rule-opentype-features-on,
    @community/fact-variable-font-axes,
    @community/rule-typography-letter-spacing,
    @community/fact-monospace-purpose,
    @community/principle-color-system-foundation,
    @community/check-color-oklch-required,
    @community/check-contrast-aa,
    @community/principle-intentional-gradient,
    @community/rule-gradients-justified-only,
    @community/pattern-gradient-mesh-engine,
    @community/anti-pattern-generic-saas-blue,
    @community/check-color-blacklist-brand,
    @community/anti-pattern-rainbow-explosion,
  ]

  contradicts: [
    @impeccable/persona-warm-institutional,
    @impeccable/persona-magazine-editorial,
  ]
}
