persona Supabase {
  id: "@community/persona-supabase"
  version: "1.0.0"

  school: supabase
  domain: visual-design

  _meta: {
    license: "Apache-2.0"
    license-provenance: "package-authorship-claim"
  }


  description: "Dark-mode-native BaaS developer aesthetic: Circular weight 400 at 1.00 line-height on near-black #171717 with PostgreSQL-green #3ecf8e as identity-only accent, depth built entirely from border-color stepping rather than shadows."

  implies: {
    font: {
      display: "Circular with fallbacks custom-font, Helvetica Neue, Helvetica, Arial"
      body: "Circular weight 400 — same family across display and body"
      monospace: "Source Code Pro with fallbacks Office Code Pro, Menlo"
    }
    color: {
      temperature: "cool-neutral"
      palette: "brand green #3ecf8e logo/accent, link green #00c573, green border rgba(62,207,142,0.3), page bg #171717, button/deepest bg #0f0f0f, primary text #fafafa, secondary text #b4b4b4, muted #898989, border subtle #242424, card border #2e2e2e, button border #363636"
      background: "#171717"
    }
    density: "airy sections — 8px base spacing, dramatic section scale 48 → 90 → 96 → 128px, cards 8–16px radius, pill CTAs at 9999px, single 600px mobile/desktop breakpoint"
    layout: "single-column hero with terminal-command density, large pill CTAs, OSS-identity section anchors with Source Code Pro uppercase mono labels"
    imagery: "product-first — terminal screenshots and database diagrams; no stock photography; glass dark rgba(41,41,41,0.84) surfaces for overlaid panels"
    motion: "minimal — rgba(0,0,0,0.1) 0px 4px 12px focus-only shadow; hover states via border-color stepping, not movement"
  }

  compatible: ["vercel-clean", "dense-pragmatist", "swiss-modernist", "tokyo-minimal"]
  conflicts: ["warm-institutional", "magazine-editorial", "notion-warm"]

  example-brands: [
    "Supabase",
  ]

  notes: [
    "72px Circular weight 400 / line-height 1.00 / normal tracking is the hero signature — zero leading applied to marketing copy like a terminal command, densely declarative.",
    "Emerald green #3ecf8e / #00c573 appears only in logo, links, and rgba(62,207,142,0.3) border accents — never backgrounds or large surfaces; saturation is signal not decoration.",
    "No shadows on dark: elevation is built by border-color stepping #242424 → #2e2e2e → #363636 → #393939 — four distinct depth levels from border alone.",
    "Pill CTAs at 9999px with #0f0f0f bg and 1px solid #fafafa white border — high-contrast inside an otherwise subdued palette.",
    "Source Code Pro uppercase labels: 12px mono + 1.2px positive letter-spacing — developer console signpost, bridges marketing to product UI.",
    "Radix primitive semantic tokens (--colors-crimson4/A9, --colors-violet10 hsl(251,63.2%,63.2%)) underpin the translucent layering system.",
    "Use for developer-authentic, OSS-identity products with engineer audiences. Avoid when targeting non-technical buyers — 1.00 line-height hero reads 'built by devs, for devs.'",
  ]

  composition: {
    must-include: [
      @impeccable/template-oklch-palette,
      @impeccable/template-oklch-dark-mode-cascade,
    ]
    must-avoid: [
      @impeccable/persona-warm-institutional,
      @impeccable/persona-notion-warm,
    ]
    typography-required: {
      display: "Circular"
      weight-signature: "400"
      line-height-display: "1.00"
    }
    color-required: {
      background: "#171717"
      accent: "#3ecf8e"
      border-depth: "#242424 → #2e2e2e → #363636"
    }
    motion-prescriptions: [
      @community/pattern-hover-lift,
      @impeccable/template-dark-mode-toggle,
    ]
  }

  related: [
    @impeccable/persona-vercel-clean,
    @impeccable/template-oklch-palette,
    @impeccable/template-dark-mode-toggle,
    @community/principle-typography-hierarchy,
    @community/check-line-length-optimal,
    @community/fact-monospace-purpose,
    @community/rule-font-self-host,
    @community/rule-typography-letter-spacing,
    @impeccable/template-oklch-dark-mode-cascade,
    @community/pattern-color-dark-mode-pairing,
    @community/principle-color-system-foundation,
    @community/check-color-oklch-required,
    @community/check-color-dark-mode-cascade,
    @community/check-contrast-aa,
    @community/rule-single-accent-color,
    @community/anti-pattern-generic-saas-blue,
    @community/check-color-blacklist-brand,
  ]

  contradicts: [
    @impeccable/persona-warm-institutional,
    @impeccable/persona-notion-warm,
  ]
}
