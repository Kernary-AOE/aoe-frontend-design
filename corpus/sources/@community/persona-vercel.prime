persona Vercel {
  id: "@community/persona-vercel"
  version: "1.0.0"

  school: vercel
  domain: visual-design

  _meta: {
    license: "Apache-2.0"
    license-provenance: "package-authorship-claim"
  }


  description: "Achromatic minimalism as engineering principle: Geist Sans with extreme -2.4px to -2.88px tracking on near-white #ffffff canvas, shadow-as-border replacing every CSS border, and grayscale-only chrome with workflow accents (Ship Red / Preview Pink / Develop Blue) reserved strictly for pipeline contexts."

  implies: {
    font: {
      display: "Geist (Geist Sans) with fallbacks Arial, Apple Color Emoji, Segoe UI Emoji"
      body: "Geist weight 400 body, 500 UI, 600 headings — no bold 700 except 7px micro-badges"
      monospace: "Geist Mono with fallbacks ui-monospace, SFMono-Regular, Roboto Mono, Menlo"
    }
    color: {
      temperature: "neutral"
      palette: "Vercel Black #171717 primary, background #ffffff, gray-600 #4d4d4d, gray-500 #666666, gray-400 #808080, gray-100 #ebebeb, gray-50 #fafafa, link blue #0072f5, workflow Ship Red #ff5b4f, Preview Pink #de1d8d, Develop Blue #0a72ef (pipeline contexts only)"
      background: "#ffffff"
    }
    density: "balanced — 8px base spacing (scale jumps 16px → 32px, no 20px or 24px), radius 2px inline / 4px small / 6px functional / 8px cards / 12px featured, 1200px max-width, 80–120px hero padding"
    layout: "gallery-empty minimalism — centered 1200px, 12-col grid, 48px/600 hero with extreme negative tracking, feature grids with shadow-bordered cards"
    imagery: "monochrome product screenshots with multi-layer shadow stacks; Develop Blue/Preview Pink/Ship Red workflow pipeline diagrams as brand imagery"
    motion: "opacity-only and shadow transitions — 200ms ease-out; no bouncy springs; liga ligatures structural not decorative"
  }

  compatible: ["vercel-clean", "swiss-modernist", "dense-pragmatist", "tokyo-minimal"]
  conflicts: ["brutalist", "warm-institutional", "notion-warm", "magazine-editorial"]

  example-brands: [
    "Vercel",
  ]

  notes: [
    "Shadow-as-border: box-shadow: 0px 0px 0px 1px rgba(0,0,0,0.08) replaces every traditional CSS border — enables rounded corners without clipping and subtler visual weight.",
    "Multi-layer card shadow stack: rgba(0,0,0,0.08) 0px 0px 0px 1px, rgba(0,0,0,0.04) 0px 2px 2px, rgba(0,0,0,0.04) 0px 8px 8px -8px, #fafafa 0px 0px 0px 1px — the inner #fafafa ring is the distinctive 'inner glow' that identifies a Vercel card.",
    "Extreme negative tracking on Geist: -2.4px to -2.88px at 48px, most aggressive of any major design system — text reads as minified compiled output.",
    "OpenType liga ligatures on every Geist element are structural, not optional — disabling them breaks the type integrity.",
    "Workflow pipeline colors (Ship Red / Preview Pink / Develop Blue) are brand metaphor, never decorative — applying them outside pipeline contexts immediately breaks the persona.",
    "Distinct from @impeccable/persona-vercel-clean: this is the actual vercel.com brand reference; persona-vercel-clean is the generic dev-tool clean school inspired by it.",
    "Use for dev-tool / infrastructure / developer-platform with achromatic restraint. Avoid when product needs warmth, playfulness, or mass-consumer appeal.",
  ]

  composition: {
    must-include: [
    @impeccable/template-oklch-palette,
    @community/pattern-button-press-feedback,
    @impeccable/template-card-hover-lift,
    ]
    must-avoid: [
    @community/anti-pattern-thin-weight-body,
    @community/anti-pattern-generic-saas-blue,
    ]
    typography-required: {
      display: "Geist Sans"
      weight-signature: "600"
      tracking: "-2.4px to -2.88px at 48px display"
    }
    color-required: {
      background: "#ffffff"
      primary: "#171717"
      border-style: "box-shadow: 0px 0px 0px 1px rgba(0,0,0,0.08)"
    }
    motion-prescriptions: [
    @impeccable/template-card-hover-lift,
    @impeccable/template-easing-curves,
    ]
  }

  related: [
    @impeccable/persona-vercel-clean,
    @impeccable/template-oklch-palette,
    @impeccable/template-card-hover-lift,
    @community/principle-typography-hierarchy,
    @community/check-line-length-optimal,
    @community/rule-typography-letter-spacing,
    @community/fact-monospace-purpose,
    @community/rule-font-feature-settings,
    @impeccable/template-oklch-dark-mode-cascade,
    @community/pattern-color-dark-mode-pairing,
    @community/principle-color-system-foundation,
    @community/check-color-oklch-required,
    @community/check-color-dark-mode-cascade,
    @community/check-contrast-aa,
    @community/rule-single-accent-color,
    @community/check-color-blacklist-brand,
  ]

  contradicts: [
    @community/anti-pattern-thin-weight-body,
    @community/anti-pattern-generic-saas-blue,
  ]
}
