principle CommitBoldAesthetic {
  id: "@community/principle-commit-bold-aesthetic"
  version: "1.0.0"

  domain: frontend-design

  _meta: {
    license: "Apache-2.0"
    license-provenance: "package-authorship-claim"
  }


  statement: "Choose and fully commit to a specific, extreme aesthetic direction before writing any implementation code. Partial commitment produces incoherent outputs; bold maximalism and refined minimalism both succeed, but the hedged middle-ground does not."

  rationale: "AI models without explicit aesthetic constraints default to safe, averaged visual choices. A committed aesthetic direction — even an unconventional one — creates coherence that a cautious hybrid cannot. The act of deciding forces every downstream decision (font, color, radius, motion) into alignment."

  implications: [
    "Select a persona (@impeccable/persona-editorial, @impeccable/persona-brutalist, etc.) before opening a code file.",
    "If the brief is ambiguous, prototype two extreme directions rather than one safe middle — let contrast testing decide.",
    "A wrong commitment is easier to fix than an uncommitted output — you can pivot from a coherent direction.",
    "Commit to an aesthetic in writing (design.md or a comment block) before touching CSS.",
  ]

  sources: [
    "Anthropic Impeccable SKILL.md — Design Thinking CRITICAL block",
  ]

  related: [
    @impeccable/principle-distinctiveness,
    @impeccable/provocation-why-not-serif,
    @community/anti-pattern-ai-slop-aesthetics,
    @community/anti-pattern-ai-generated-ui,
    @community/example-resend-hero,
    @community/example-vercel-hero-gradient,
    @community/principle-single-direction-aesthetic-bet,
    @community/principle-taste-as-engineering,
  ]
}
