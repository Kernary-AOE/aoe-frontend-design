rule AriaNativeFirst {
  id: "@community/rule-aria-native-first"
  version: "1.0.0"

  domain: frontend-design

  _meta: {
    license: "Apache-2.0"
    license-provenance: "package-authorship-claim"
  }


  description: "Use a native HTML element before applying ARIA roles, states, or properties — native semantics are more robust, require less maintenance, and have broader assistive technology support than ARIA overrides (ARIA in HTML spec §2.1 'First Rule of ARIA Use')."

  rationale: "ARIA is a patch for gaps in HTML semantics, not a replacement. Native elements (<button>, <input>, <select>, <details>) ship with built-in keyboard interaction, focus management, and screen-reader semantics. A <div role='button'> requires explicit tabindex, keydown handlers, and aria-pressed — all of which degrade silently when any one piece is missing."

  rule: |
    Decision order:
    1. Does a native HTML element express this semantics? → Use it. Done.
    2. Is the native element stylistically impossible to theme? → Use it + CSS (e.g. <button>/<select> with appearance: none).
    3. No native element exists for this pattern (combobox, listbox, tree, grid)? → Build with ARIA roles + full keyboard pattern.

  examples: |
    // ❌ ARIA bandaid — div with ARIA where a button would do
    <div role="button" tabindex="0" aria-pressed="false" onclick="toggle()">
      Toggle
    </div>

    // ✅ Native — all semantics built in
    <button type="button" onclick="toggle()">Toggle</button>

    // ✅ Legitimate ARIA — combobox has no native HTML equivalent
    <div role="combobox" aria-expanded="false" aria-haspopup="listbox" aria-controls="options">
      <input type="text" aria-autocomplete="list" />
    </div>
    <ul id="options" role="listbox">...</ul>

  counter-examples: [
    @community/counter-example-aria-bandaid,
    @community/counter-example-div-button-no-tabindex,
    @community/counter-example-div-onclick-dropdown,
  ]

  severity: warning

  verification: "Search codebase for role='button' | role='link' | role='checkbox' | role='radio' | role='tab' on non-semantic elements; verify each has no native equivalent."

  related: [
    @community/counter-example-aria-bandaid,
    @community/counter-example-div-button-no-tabindex,
    @community/rule-keyboard-accessible,
    @community/counter-example-div-onclick-dropdown,
    @community/anti-pattern-breaking-keyboard-flow,
    @community/example-radix-dropdown,
  ]
}
