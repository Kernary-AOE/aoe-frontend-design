rule ButtonTypeExplicit {
  id: "@community/rule-button-type-explicit"
  version: "1.0.0"

  applies-to: @community/type-html-artifact

  domain: frontend-engineering

  _meta: {
    license: "Apache-2.0"
    license-provenance: "package-authorship-claim"
  }


  description: "Every `<button>` element MUST declare an explicit `type` attribute (`button`, `submit`, or `reset`). The HTML default is `submit`, which inside a `<form>` causes any unrelated button (e.g. an icon toggle) to submit the form on click — a common, hard-to-debug bug."

  claim: "Every `<button>` element MUST have an explicit `type='button'`, `type='submit'`, or `type='reset'` attribute — relying on the default is forbidden."

  severity: high

  validates-with: [
    @community/fact-error-prevention,
  ]

  checks: [
    @community/check-button-type-explicit,
  ]

  severity-combination: |
    <button> inside a form without type=  → BLOCK
    <button> outside a form without type= → WARN
    <button type='...'>                   → PASS

  failure-mode: "An icon-toggle button inside a form silently submits the form; users lose unsaved state; double-submission charges customers twice. The bug is invisible until production traffic hits the right page."

  remediation: [
    "Add `type='button'` to every button that is NOT the form's submit action.",
    "Add `type='submit'` to the one button intended to submit (and prefer placing only one).",
    "Add a lint rule (`react/button-has-type` for React, `@angular-eslint/template/button-has-type` for Angular) to enforce in CI.",
    "Wrap legacy buttons during migration: `const SafeButton = (p) => <button type='button' {...p} />`.",
  ]

  exceptions: [
    {
      case: "Submit-only inside a single-field form",
      allowed-when: "A form has exactly one button whose purpose is submit; defaulting still works — but adding the attr costs nothing.",
    }
  ]

  notes: [
    "This rule is mechanically lintable — no runtime DOM check needed; static analysis is sufficient.",
    "The default-type bug is one of the top three causes of 'mysterious form submit' tickets in React apps.",
  ]

  related: [
    @community/rule-form-validation-inline,
    @community/fact-error-prevention,
    @community/rule-aria-label-required,
  ]

  see-also: [
    @community/check-button-type-explicit,
  ]
}
