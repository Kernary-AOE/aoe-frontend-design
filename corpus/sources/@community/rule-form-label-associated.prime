rule FormLabelAssociated {
  id: "@community/rule-form-label-associated"
  version: "1.0.0"

  applies-to: @community/type-html-artifact

  domain: accessibility

  _meta: {
    license: "Apache-2.0"
    license-provenance: "package-authorship-claim"
  }


  description: "Every form control (`<input>`, `<select>`, `<textarea>`, custom widgets with role='textbox' / 'combobox' / 'listbox') MUST have a programmatically-associated label — via `<label for='id'>`, wrapping `<label>`, `aria-label`, or `aria-labelledby`. Placeholder text alone is NEVER a label."

  claim: "Every form control MUST have a programmatic accessible name set via `<label for>`, wrapping `<label>`, `aria-label`, or `aria-labelledby` — placeholder text MUST NOT be the only label."

  severity: critical

  validates-with: [
    @w3c/source-wcag-22,
  ]

  checks: [
    @community/check-form-label-associated,
  ]

  severity-combination: |
    input has no associated label                  → BLOCK  (SC 1.3.1, 4.1.2)
    input uses placeholder as label only           → BLOCK  (SC 3.3.2)
    input wrapped in <label> or has matching for=  → PASS
    custom widget has aria-labelledby              → PASS

  failure-mode: "Screen-reader users hear 'edit' or 'combobox' with no purpose; voice-control users cannot say 'click <field name>'; users with cognitive impairment lose context the moment they type and the placeholder disappears. WCAG Level A fails."

  remediation: [
    "Replace `<input placeholder='Email'>` with `<label for='email'>Email</label><input id='email' type='email'>`.",
    "For visually compact UI, hide the label with `.sr-only` rather than removing it — keeps screen-reader access.",
    "For custom widgets (combobox, datepicker), use `aria-labelledby='external-label-id'`.",
    "Use `aria-describedby` (NOT label) for hints / format examples.",
  ]

  exceptions: [
    {
      case: "Search field with explicit aria-label",
      allowed-when: "A globally-recognizable search input may use `<input type='search' aria-label='Search'>` without a visible label, but a visible label is still preferred.",
    }
  ]

  notes: [
    "Placeholder vanishes on input — once typed, the user (and screen-reader return-to-field) loses the cue. This is a common WCAG audit failure.",
    "Floating-label patterns are accessible IF the label is a real `<label for>` that animates into the placeholder position.",
  ]

  related: [
    @community/rule-error-message-associated,
    @community/rule-form-validation-inline,
    @w3c/source-wcag-22,
    @impeccable/template-form-validation,
    @community/example-calcom-scheduler,
    @community/example-plaid-connect,
    @community/rule-upfront-field-requirements,
    @community/rule-accessibility-first-class,
  ]

  see-also: [
    @community/check-form-label-associated,
  ]
}
