rule HeadingHierarchy {
  id: "@community/rule-heading-hierarchy"
  version: "1.0.0"

  applies-to: @community/type-html-artifact

  domain: accessibility

  _meta: {
    license: "Apache-2.0"
    license-provenance: "package-authorship-claim"
  }


  description: "Heading elements (`h1`–`h6`) MUST form a strict, gap-free hierarchy: exactly one `h1` per document, and each subsequent heading is at most one level deeper than its predecessor. Skipping levels (e.g. `h2` directly to `h4`) and using multiple `h1`s is forbidden."

  claim: "An HTML document MUST contain exactly one `h1`, and no heading MUST be more than one level deeper than the most recent preceding heading."

  severity: high

  validates-with: [
    @w3c/source-wcag-22,
  ]

  checks: [
    @community/check-heading-hierarchy,
  ]

  severity-combination: |
    document has 0 or >1 h1                       → BLOCK  (WCAG SC 1.3.1, 2.4.6)
    heading level skip detected (e.g. h2 → h4)    → BLOCK
    headings styled with non-heading tags         → WARN

  failure-mode: "Screen-reader users navigate by heading; broken hierarchy makes the document outline unintelligible. Search engines down-rank pages with malformed outlines. Visual-only 'big bold text' that is not an h-tag is invisible to assistive tech."

  remediation: [
    "Audit the heading outline with the WAVE or axe extension — verify a single h1 and contiguous levels.",
    "Replace styled `<div class='heading-lg'>` with a real `<h2>` (and style the h2).",
    "If a section truly has no parent heading, lift it to its proper level rather than jumping numbers.",
    "Use the HTML5 outline algorithm: each `<section>` resets the implicit level — but always verify with a real screen reader.",
  ]

  exceptions: [
    {
      case: "Standalone widgets without page context",
      allowed-when: "An embedded widget (e.g. a third-party chat) renders inside a host page; the widget owns its internal hierarchy starting at h2 or below.",
    }
  ]

  notes: [
    "The 'one h1' rule is debated for HTML5 sectioning, but assistive tech support for the sectioning outline is still incomplete — keep it to one h1 in 2026.",
  ]

  related: [
    @community/rule-aria-label-required,
    @w3c/source-wcag-22,
    @community/collection-accessible-frontend,
    @community/anti-pattern-thin-weight-body,
    @community/example-linear-issues-table,
    @community/example-notion-blocks,
    @community/principle-typography-hierarchy,
  ]

  see-also: [
    @community/check-heading-hierarchy,
  ]
}
