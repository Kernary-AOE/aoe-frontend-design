rule IosFlexibleLayout {
  id: "@community/rule-ios-flexible-layout"
  version: "1.0.0"

  domain: frontend-design

  _meta: {
    license: "Apache-2.0"
    license-provenance: "package-authorship-claim"
  }


  applies-to: "all iOS screen layouts for iPhone"

  statement: "Layouts must adapt from iPhone SE (375pt width) to iPhone Pro Max (430pt width) without hardcoded widths or fixed dimensions."

  rationale: "Fixed widths break on small screens (SE clips content) and waste space on large ones (Pro Max shows awkward gaps). Flexible relative sizing covers the full iPhone point-width range of 375–430pt."

  examples: [
    "Use .frame(maxWidth: .infinity) on cards instead of .frame(width: 350).",
    "Test on both smallest (iPhone SE 375pt) and largest (iPhone 16 Pro Max 430pt) in the Xcode canvas.",
    "Use GeometryReader only when a dimension truly needs to be a percentage of the screen; prefer stack-based relative sizing.",
  ]

  notes: [
    "Verify by previewing on iPhone SE and iPhone Pro Max in the Xcode canvas side-by-side.",
    "Apple HIG source: Rule 1.4 — Support All iPhone Screen Sizes.",
  ]

  related: [
    @community/rule-ios-8pt-grid,
    @community/rule-ios-safe-area-insets,
    @community/rule-ios-dynamic-type-reflow,
  ]
}
