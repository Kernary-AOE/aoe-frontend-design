rule IosSafeAreaInsets {
  id: "@community/rule-ios-safe-area-insets"
  version: "1.0.0"

  domain: frontend-design

  _meta: {
    license: "MIT AND Apache-2.0"
    license-provenance: "legacy-backfill"
  }


  applies-to: "all content and interactive elements positioned in an iOS view"

  statement: "Never place interactive or essential content under the status bar, Dynamic Island, or home indicator; respect UIEdgeInsets from safeAreaInsets / safeAreaLayoutGuide at all times."

  rationale: "System chrome physically obscures content placed outside safe areas, making it unreachable or invisible. The Dynamic Island on iPhone 14 Pro and later occupies more vertical space than a standard notch and must be accounted for explicitly."

  examples: [
    "Verify on a physical iPhone 15 Pro or Dynamic Island Simulator: nothing clipped under the island or home indicator.",
    "Background fills may extend edge-to-edge; all text, buttons, and interactive elements must be inset.",
    "In SwiftUI: default safe area is automatically respected; only extend background with .ignoresSafeArea(.container) on Color or Image layers.",
  ]

  notes: [
    "In UIKit: use view.safeAreaLayoutGuide anchors instead of view.topAnchor / view.bottomAnchor directly.",
    "Apple HIG source: Rule 1.2 — Respect Safe Areas.",
  ]

  related: [
    @community/anti-pattern-ios-ignore-safe-area,
    @community/rule-ios-flexible-layout,
    @community/constraint-ios-touch-target-44pt,
    @community/anti-pattern-ios-fullscreen-spinner,
    @community/rule-ios-tab-bar-always-visible,
  ]
}
