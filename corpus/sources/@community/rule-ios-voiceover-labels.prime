rule IosVoiceoverLabels {
  id: "@community/rule-ios-voiceover-labels"
  version: "1.0.0"

  domain: frontend-design

  _meta: {
    license: "MIT AND Apache-2.0"
    license-provenance: "legacy-backfill"
  }


  applies-to: "all buttons, controls, images, and tappable elements in iOS views"

  statement: "Every interactive element must have a descriptive .accessibilityLabel that communicates its purpose; icon-only buttons with no visible text are the most common failure case."

  rationale: "Without labels, VoiceOver reads raw SF Symbol names (e.g., 'heart, image') or nothing at all, making the app completely unusable for blind users. This is a blocking accessibility requirement per WCAG 1.1.1 and Apple HIG Rule 5.1."

  examples: [
    "Icon-only like button: .accessibilityLabel('Like').accessibilityHint('Double-tap to like this post').",
    "Image: Image('headerPhoto').accessibilityLabel('Mountain landscape at sunrise').",
    "Decorative image: Image('divider').accessibilityHidden(true).",
    "Verify: enable VoiceOver and navigate; every element must be announced with a clear, meaningful label.",
  ]

  notes: [
    "Label describes what the element IS; hint (optional) describes what happens when activated.",
    "Text-bearing controls (Text buttons, labeled toggles) automatically use their visible text as the accessibility label.",
    "Apple HIG source: Rule 5.1 — VoiceOver Labels on All Interactive Elements.",
  ]

  related: [
    @community/rule-ios-voiceover-order,
    @community/rule-ios-reduce-motion,
    @community/check-ios-bold-text-support,
  ]
}
