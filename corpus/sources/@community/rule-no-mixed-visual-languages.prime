rule NoMixedVisualLanguages {
  id: "@community/rule-no-mixed-visual-languages"
  version: "1.0.0"

  domain: frontend-design

  _meta: {
    license: "Apache-2.0"
    license-provenance: "package-authorship-claim"
  }


  description: "Corner radii, shadow styles, and type scales must be visually consistent within any single user flow — mixing divergent visual language systems (e.g., sharp-cornered inputs with heavily rounded buttons) within the same flow is forbidden."

  claim: "A single user flow must use one coherent visual language; components cannot import styles from a different design system or persona without explicit adaptation."

  severity: medium

  examples: [
    "Violation: a signup flow with rounded Material inputs (border-radius:4px) next to a button with border-radius:24px from a different design system",
    "Violation: dashboard uses Inter sans-serif throughout except one widget using Georgia — font inconsistency within flow",
    "Violation: card shadows use a flat neo-brutalist border in the modal but a soft drop-shadow in the parent page",
    "Correct: define one border-radius scale, one shadow scale, one type scale — apply uniformly within the flow",
  ]

  related: [
    @community/principle-shared-visual-language,
    @community/rule-no-new-visual-primitives,
    @community/anti-pattern-ai-generated-ui,
    @community/example-shadcn-settings,
    @community/example-tailwindui-app-shell,
    @community/principle-single-direction-aesthetic-bet,
  ]
}
