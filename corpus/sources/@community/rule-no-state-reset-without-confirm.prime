rule NoStateResetWithoutConfirm {
  id: "@community/rule-no-state-reset-without-confirm"
  version: "1.0.0"

  domain: frontend-design

  _meta: {
    license: "Apache-2.0"
    license-provenance: "package-authorship-claim"
  }


  description: "Navigation away, session timeout, or flow reset must not silently discard unsaved changes or mid-flow state — users must be prompted to confirm or offered to save before loss occurs."

  claim: "Any navigation action that would destroy unsaved user input or mid-flow progress must trigger a confirmation dialog or an auto-save before proceeding."

  severity: high

  patterns: [
    "beforeunload event: warn before browser navigation away from dirty forms",
    "Router guard: intercept SPA navigation with 'You have unsaved changes — leave?' dialog",
    "Auto-save: persist form state to localStorage every 30 seconds; restore on return",
    "Session timeout: warn 2 minutes before expiry with 'Extend session' option, not silent redirect",
  ]

  exceptions: [
    "Explicitly canceling a task (Cancel button) — user initiated, no confirmation needed if labeled clearly",
    "Changes that are immediately reversible (optimistic toggle) — no confirmation needed",
  ]

  related: [
    @community/rule-save-form-progress,
    @community/fact-user-control-freedom,
  ]
}
