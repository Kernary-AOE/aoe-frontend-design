transform PxToRem {
  id: "@community/transform-px-to-rem"
  version: "1.0.0"

  signature: (px: number, rootSize?: number) -> string
  pure: true

  domain: visual-design

  _meta: {
    license: "Apache-2.0"
    license-provenance: "package-authorship-claim"
  }


  description: "Converts a CSS pixel value to its rem equivalent relative to the root element font-size (default 16px). rem-based sizing is an accessibility requirement: when users override their browser's default font size, rem values scale proportionally while px values do not."

  body: """
    function pxToRem(px, rootSize = 16) {
      if (typeof px !== 'number' || !isFinite(px)) {
        throw new TypeError('px must be a finite number');
      }
      if (rootSize <= 0) {
        throw new RangeError('rootSize must be positive');
      }
      const rem = px / rootSize;
      // Trim trailing zeros, preserve up to 4 decimals
      const formatted = parseFloat(rem.toFixed(4));
      return `${formatted}rem`;
    }
  """

  examples: [
    { input: { px: 16 }, output: "1rem" }
    { input: { px: 24 }, output: "1.5rem" }
    { input: { px: 14 }, output: "0.875rem" }
    { input: { px: 1 }, output: "0.0625rem" }
    { input: { px: 32, rootSize: 16 }, output: "2rem" }
    { input: { px: 32, rootSize: 18 }, output: "1.7778rem" }
  ]

  inverse: "@community/transform-rem-to-px"

  notes: [
    "Default browser root font-size is 16px. NEVER set `html { font-size: 62.5% }` (the 'magic number' for 1rem = 10px) — it overrides user accessibility preferences and breaks any UI that assumed 16px root.",
    "For sub-pixel values (1px borders), prefer keeping `1px` literal rather than `0.0625rem`. Borders that scale with user font-size become unexpectedly thick.",
    "`em` is relative to the parent's font-size and compounds with nesting; `rem` is always relative to root and does not compound. Prefer `rem` for sizing, `em` for text-relative spacing inside a typographic block.",
    "Pair with `clamp()` for fluid sizing: `font-size: clamp(1rem, 0.9rem + 0.5vw, 1.25rem)` scales between 1rem and 1.25rem responsively while still respecting user font-size.",
    "Build-time alternative: PostCSS plugins like `postcss-pxtorem` automate conversion, but explicit rem tokens are clearer than implicit transforms.",
    "WCAG 1.4.4 Resize Text requires that text remain functional when scaled to 200%; rem-based sizing makes this trivial.",
  ]

  related: [
    @community/type-spacing-scale,
    @community/transform-scale-clamp,
    @community/anti-pattern-hardcoded-pixel-values,
    @community/term-rasterization,
  ]
}
