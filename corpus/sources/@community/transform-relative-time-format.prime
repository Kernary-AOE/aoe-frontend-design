transform RelativeTimeFormat {
  id: "@community/transform-relative-time-format"
  version: "1.0.0"

  signature: (date: Date, now: Date, locale: string) -> string
  pure: true

  domain: i18n

  _meta: {
    license: "Apache-2.0"
    license-provenance: "package-authorship-claim"
  }


  description: "Formats a date as a localized relative time string ('5 minutes ago', 'in 2 days', 'last month') using the platform `Intl.RelativeTimeFormat` API. Replaces hand-rolled English-only date utilities with locale-aware formatting that handles plurals, gender, and grammatical agreement automatically."

  body: """
    /**
     * Format a date as a localized relative time string.
     *
     * Uses Intl.RelativeTimeFormat (built into Node 12+, all modern browsers).
     */
    function relativeTimeFormat(date, now = new Date(), locale = 'en') {
      if (!(date instanceof Date) || isNaN(date.getTime())) {
        throw new TypeError('date must be a valid Date');
      }
      if (!(now instanceof Date) || isNaN(now.getTime())) {
        throw new TypeError('now must be a valid Date');
      }

      const rtf = new Intl.RelativeTimeFormat(locale, {
        numeric: 'auto',     // 'yesterday' instead of '1 day ago'
        style: 'long',       // 'in 5 minutes' (vs 'short' = 'in 5 min', 'narrow' = 'in 5m')
      });

      const diffMs = date.getTime() - now.getTime();
      const diffSec = Math.round(diffMs / 1000);
      const absSec = Math.abs(diffSec);

      // Choose the largest unit that gives a value >= 1
      if (absSec < 45) return rtf.format(diffSec, 'second');
      if (absSec < 3600) return rtf.format(Math.round(diffSec / 60), 'minute');
      if (absSec < 86400) return rtf.format(Math.round(diffSec / 3600), 'hour');
      if (absSec < 604800) return rtf.format(Math.round(diffSec / 86400), 'day');
      if (absSec < 2592000) return rtf.format(Math.round(diffSec / 604800), 'week');
      if (absSec < 31536000) return rtf.format(Math.round(diffSec / 2592000), 'month');
      return rtf.format(Math.round(diffSec / 31536000), 'year');
    }
  """

  examples: [
    { input: { date: "2026-05-07T10:00:00Z", now: "2026-05-07T10:05:00Z", locale: "en" }, output: "'5 minutes ago'" }
    { input: { date: "2026-05-07T10:00:00Z", now: "2026-05-07T10:05:00Z", locale: "fr" }, output: "'il y a 5 minutes'" }
    { input: { date: "2026-05-07T10:00:00Z", now: "2026-05-07T10:05:00Z", locale: "ja" }, output: "'5 分前'" }
    { input: { date: "2026-05-07T10:00:00Z", now: "2026-05-07T10:05:00Z", locale: "ar" }, output: "'قبل 5 دقائق'" }
    { input: { date: "2026-05-08T10:00:00Z", now: "2026-05-07T10:00:00Z", locale: "en" }, output: "'tomorrow'" }
    { input: { date: "2026-05-06T10:00:00Z", now: "2026-05-07T10:00:00Z", locale: "en" }, output: "'yesterday'" }
  ]

  inverse: null

  notes: [
    "`Intl.RelativeTimeFormat` is supported everywhere (Node 12+, Chrome 71+, Firefox 65+, Safari 14+). No polyfill needed for modern targets.",
    "`numeric: 'auto'` produces idiomatic forms like 'yesterday', 'last week' instead of '1 day ago'. Set to 'always' for technical UIs that need exact numbers.",
    "Localized plurals are handled by the API — Russian 'один день назад' / 'два дня назад' / 'пять дней назад' for 1/2/5 days. Don't hand-roll plural logic (see @community/principle-no-string-concat).",
    "For absolute dates (e.g. 'May 7, 2026'), pair with `Intl.DateTimeFormat`. Use relative for recent events (< 1 day), absolute for older.",
    "RTL locales (Arabic, Hebrew, Persian) produce RTL-suitable output; rendering still requires correct dir attribute (see @community/fact-bidi-direction).",
    "Update timer: relative-time strings drift; UIs showing '5 minutes ago' should re-render every minute (or use IntersectionObserver to update only visible items).",
    "Beware of timezone misalignment: 'yesterday' depends on the user's timezone, not the server's — pass dates in UTC and let the API + browser handle locale.",
  ]

  related: [
    @community/type-locale-tag,
    @community/transform-locale-fallback-chain,
    @community/rule-intl-api-locale-formatting,
    @community/principle-no-string-concat,
    @community/pattern-icu-message-format,
  ]
}
