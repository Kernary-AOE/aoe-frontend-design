transform ScaleClamp {
  id: "@community/transform-scale-clamp"
  version: "1.0.0"

  signature: (minSize: px, maxSize: px, minVp: px, maxVp: px) -> string
  pure: true

  domain: visual-design

  _meta: {
    license: "Apache-2.0"
    license-provenance: "package-authorship-claim"
  }


  description: "Generates a CSS `clamp()` expression for fluid typography or spacing that linearly interpolates between minSize at minVp viewport width and maxSize at maxVp viewport width, clamped at both ends. The result is a single CSS value string suitable for use in a design token or component style."

  body: """
    // Fluid type formula (Mike Riethmüller / CSS-Tricks)
    // clamp(minSize, minSize + (maxSize - minSize) * (100vw - minVp) / (maxVp - minVp), maxSize)

    function px(n) { return n + 'px'; }
    function rem(n) { return (n / 16).toFixed(4) + 'rem'; }

    const slope = (maxSize - minSize) / (maxVp - minVp);
    const intercept = minSize - slope * minVp;

    const preferred = `${intercept > 0 ? '+' : ''}${intercept.toFixed(4)}px + ${(slope * 100).toFixed(4)}vw`;
    // Using rem for min/max improves zoom behavior:
    return `clamp(${rem(minSize)}, calc(${preferred}), ${rem(maxSize)})`;
  """

  example: {
    input: { minSize: 16, maxSize: 22, minVp: 320, maxVp: 1280 }
    output: "clamp(1.0000rem, calc(14.3333px + 0.6250vw), 1.3750rem)"
  }

  notes: [
    "Use rem for min/max so the values scale with user browser font-size preference — this is an accessibility requirement.",
    "Do NOT use `vw` alone without clamp: text can become illegibly large or small.",
    "This transform is used in @impeccable/template-fluid-type.",
  ]

  related: [
    @community/category-typography-scale,
    @impeccable/template-oklch-palette,
  ]
}
