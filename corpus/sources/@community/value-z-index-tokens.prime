value ZIndexTokens {
  id: "@community/value-z-index-tokens"
  version: "1.0.0"

  name: "z-index-scale"
  constant: "[0, 10, 100, 1000, 1100, 1200, 1300, 9999]"
  type: z-index-token-set

  domain: visual-design

  _meta: {
    license: "Apache-2.0"
    license-provenance: "package-authorship-claim"
  }


  rationale: "Hardcoded `z-index: 9999` is a recurring anti-pattern that breaks composability — every component author guesses higher than the last, leading to z-index inflation. A documented, named scale assigns each stacking layer a deliberate value. Components consume the token, not the literal. The exponential gap between tiers (10 → 100 → 1000) leaves room for future intermediate layers without renumbering."

  usage: """
    /* Design tokens (CSS custom properties) */
    :root {
      --z-base: 0;
      --z-raised: 10;          /* slightly elevated content (sticky headers) */
      --z-dropdown: 100;       /* select menus, navigation flyouts */
      --z-overlay: 1000;       /* dark backdrop behind modal */
      --z-modal: 1100;         /* modal/dialog content */
      --z-popover: 1200;       /* popovers anchored to triggers */
      --z-toast: 1300;         /* notifications above everything */
      --z-debug: 9999;         /* devtools-only overlays */
    }

    /* Component usage */
    .modal-backdrop { z-index: var(--z-overlay); }
    .modal-dialog   { z-index: var(--z-modal); }
    .toast          { z-index: var(--z-toast); }
    .tooltip        { z-index: var(--z-popover); }
  """

  layers: {
    "base": { value: 0, purpose: "default flow content" }
    "raised": { value: 10, purpose: "sticky headers, raised cards" }
    "dropdown": { value: 100, purpose: "select menus, nav flyouts, autocomplete lists" }
    "overlay": { value: 1000, purpose: "dimmed backdrops behind modals" }
    "modal": { value: 1100, purpose: "modal/dialog surfaces" }
    "popover": { value: 1200, purpose: "popovers, anchored cards (ABOVE modals when triggered from modal)" }
    "toast": { value: 1300, purpose: "transient notifications, snackbars" }
    "debug": { value: 9999, purpose: "devtools, debug overlays — never in production UI" }
  }

  notes: [
    "z-index only applies within a stacking context (see @community/term-z-index-stacking-context). A high token value will not escape an isolated parent.",
    "Modals and popovers should render via portal to `document.body` to escape ancestor stacking contexts. THEN the token value behaves as expected.",
    "Avoid additive arithmetic: `z-index: calc(var(--z-modal) + 1)` defeats the purpose. If you need a new layer, add a named tier.",
    "Toast above popover above modal above overlay above dropdown is the canonical order. Reverse only with strong justification (e.g. tooltip helping a user inside a modal can sit above the modal at popover tier).",
    "Tailwind's default scale (z-0, z-10, z-20, z-30, z-40, z-50, z-auto) is finer-grained but lacks semantic naming. Map Tailwind utilities to semantic tokens via plugins.",
  ]

  related: [
    @community/term-z-index-stacking-context,
    @community/collection-accessible-modal,
    @community/type-color-token-shape,
    @community/anti-pattern-magic-numbers,
  ]
}
