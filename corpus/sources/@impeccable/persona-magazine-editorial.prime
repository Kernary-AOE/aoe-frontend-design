persona MagazineEditorial {
  id: "@impeccable/persona-magazine-editorial"
  version: "1.0.0"

  school: magazine-editorial
  domain: visual-design

  _meta: {
    license: "Apache-2.0"
    license-provenance: "package-authorship-claim"
  }


  description: "The web translation of Wired, NYT Magazine, and Pitchfork: oversized display serifs at 96-160px, drop caps, asymmetric multi-column flow, full-bleed photo essays, small-caps section heads, byline-dateline-photo-credit typography, dramatic scale contrast between display and body."

  implies: {
    font: {
      display: "high-contrast display serif, large and dramatic — e.g. GT Sectra, Tiempos Headline, Domaine Display, Canela, Ogg, Reckless, Tobias Frere-Jones Mallory"
      body: "transitional or old-style serif at 18-20px — e.g. Tiempos Text, Lyon Text, Mercury Text, GT Sectra Text, Source Serif 4, Charter"
      accent: "small-caps grotesk for section labels and bylines — e.g. Söhne Schmal, GT America Mono, Tiempos Headline small-caps"
    }
    color: {
      temperature: "neutral-warm"
      palette: "near-white paper + ink-black + ONE editorial accent (often issue-specific) — #f8f6f1 / #1a1a1a / accent varies per article (deep red #8b2222, ochre #c08a3e, or magazine-blue #1e3a8a)"
      background: "#f8f6f1 or #fbf9f4 (warm magazine paper) — pure white only acceptable for full-bleed photo background"
    }
    density: "dramatic contrast — display 96-160px against body 18-20px (5-8x ratio), line-height 1.15 on display and 1.55 on body, paragraph spacing 1.5em"
    layout: "asymmetric multi-column (2-col article body, 1-col pull-quotes spanning, full-bleed photo breaks), drop cap on first paragraph, side-note margins on desktop, photo essays with caption-credit pairs"
    imagery: "commissioned editorial photography (not stock), full-bleed image breaks every 3-5 paragraphs, photo credits in small caps below image, illustration as feature-piece anchor"
    motion: "minimal but intentional — fade-in on scroll for images, parallax for hero photo OK, no scroll-jacking, no carousel-on-hover"
  }

  compatible: ["editorial", "warm-institutional", "literary", "long-form", "refined"]
  conflicts: ["brutalist", "swiss-modernist", "vercel-clean", "stripe-fintech", "dense-pragmatist"]

  example-brands: [
    "Wired (longform features)",
    "The Atlantic",
    "NYT Magazine",
    "Pitchfork (review pages)",
    "The Verge (feature stories, not news)",
    "Aeon Magazine",
    "The New Yorker (longform)",
    "It's Nice That feature articles",
  ]

  notes: [
    "Distinct from @impeccable/persona-editorial: that persona is restrained literary; this one is DRAMATIC. Display type at 120px is the signature. If your H1 is under 64px you've drifted back into editorial.",
    "The drop cap + small-caps byline + photo-credit-in-italic-sans triad is non-negotiable. Drop any one and the page reads as a generic blog.",
    "Don't pair magazine-editorial with sans body — the persona requires serif body for that 'I'm reading a real magazine' feel. Sans body collapses it into generic blog.",
    "Per-article accent color is a defining feature — Wired changes it per feature, NYT Magazine per issue. A single global accent is fintech thinking, not magazine thinking.",
    "Pull-quotes must be set in display serif at 32-48px and break the column grid asymmetrically. A pull-quote constrained to body column is a missed opportunity.",
  ]

  composition: {
    must-include: [
      @community/principle-vertical-rhythm,
      @community/principle-typography-hierarchy,
      @community/fact-type-scale-modular,
    ]
    must-avoid: [
      @impeccable/persona-dense-pragmatist,
      @impeccable/persona-brutalist,
    ]
    typography-required: {
      display: "high-contrast display serif (GT Sectra | Tiempos Headline | Canela)"
      body: "transitional or old-style serif, 18-20px"
      display-size: "96-160px"
    }
    color-required: {
      background: "#f8f6f1 or #fbf9f4 (warm magazine paper)"
      palette: "per-article accent (issue-specific, not global)"
    }
    motion-prescriptions: [
      @community/principle-vertical-rhythm,
    ]
  }

  related: [
    @impeccable/persona-editorial,
    @impeccable/persona-warm-institutional,
    @community/fact-optimal-line-length,
    @community/principle-typography-hierarchy,
    @community/check-line-length-optimal,
    @community/principle-vertical-rhythm,
    @community/rule-line-length-optimal,
    @community/fact-type-scale-modular,
    @community/check-heading-hierarchy,
    @community/principle-color-system-foundation,
    @community/check-contrast-aa,
    @community/rule-single-accent-color,
    @community/constraint-no-pure-white-bg,
    @community/rule-backgrounds-atmospheric,
    @community/check-color-blacklist-brand,
    @community/anti-pattern-generic-saas-blue,
  ]

  contradicts: [
    @impeccable/persona-dense-pragmatist,
    @impeccable/persona-brutalist,
  ]
}
