taxonomy NielsenTenHeuristics {
  id: "@nielsen/taxonomy-10-heuristics"
  version: "1.0.0"

  label: "Nielsen's 10 Usability Heuristics"
  source: @nielsen/source-nielsen-1994

  domain: ux-design

  _meta: {
    license: "LicenseRef-NNG-Citation-Only AND Apache-2.0"
    license-provenance: "package-authorship-claim"
  }


  description: "Jakob Nielsen's ten general principles for interaction design, derived from factor analysis of 249 usability problems. Used as the evaluation framework in heuristic review sessions. Each member fact represents one heuristic."

  members: [
    @community/fact-match-real-world,
    @community/fact-user-control-freedom,
    @community/fact-consistency-standards,
    @community/fact-error-prevention,
    @community/fact-recognition-over-recall,
    @community/fact-flexibility-efficiency,
    @community/fact-aesthetic-minimalist-design,
    @community/fact-help-recover-errors,
    @community/fact-help-documentation,
  ]

  evaluation-scale: {
    0: "Not a usability problem at all"
    1: "Cosmetic problem only — fix only if spare time"
    2: "Minor usability problem — low priority fix"
    3: "Major usability problem — important to fix"
    4: "Usability catastrophe — fix before release"
  }

  notes: [
    "For heuristic evaluation, use 3–5 evaluators independently, then aggregate. Single evaluator finds ~35% of problems.",
    "Each heuristic in members is a Fact atom that can be independently cited by other atoms.",
    "This taxonomy is the primary reference in @community/method-heuristic-review.",
  ]

  related: [
    @nielsen/source-nielsen-1994,
    @community/method-heuristic-review,
    @community/step-apply-heuristics,
  ]

  relationships: [
    @community/fact-match-real-world,
    @community/fact-user-control-freedom,
    @community/fact-consistency-standards,
    @community/fact-error-prevention,
    @community/fact-recognition-over-recall,
    @community/fact-flexibility-efficiency,
  ]
}
