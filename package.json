{
  "name": "@aoe-domain/frontend-design",
  "version": "0.2.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "description": "Reference Frontend Design Domain Package for AOE: model, corpus, adapters, tools, and Agent Skills.",
  "workspaces": ["../aoe-engine/packages/*"],
  "exports": {
    ".": "./adapters/design-ranker/src/index.ts",
    "./intent-classifier": "./adapters/intent-classifier/src/index.ts",
    "./design-ranker": "./adapters/design-ranker/src/index.ts",
    "./html-validator": "./adapters/html-validator/src/index.ts",
    "./design-resolver": "./adapters/design-resolver/src/index.ts",
    "./scout-catalog": "./adapters/scout-catalog/src/index.ts",
    "./mcp": "./mcp/src/index.ts",
    "./mcp/server": "./mcp/src/server.ts"
  },
  "scripts": {
    "build": "bun run typecheck",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test adapters mcp test",
    "model:check": "bun ../aoe-engine/packages/testkit/src/cli.ts model model",
    "corpus:check": "bun ../aoe-engine/packages/testkit/src/cli.ts corpus model corpus/prime-corpus.yaml",
    "corpus:build": "bun ../aoe-engine/scripts/build-atom-dirs.ts --src corpus/sources --out corpus/dist --model model --corpus com.kernary.aoe/frontend-design --release 2026-08-31",
    "corpus:verify": "bun ../aoe-engine/packages/testkit/src/cli.ts bundle corpus/dist --require-signature",
    "smoke": "bun scripts/smoke.ts",
    "compile": "bun run corpus:build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@aoe/ir": "workspace:*",
    "@aoe/model-schema": "workspace:*",
    "@aoe/query-engine": "workspace:*",
    "@aoe/runtime": "workspace:*",
    "@aoe/sdk-codegen": "workspace:*",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "bun-types": "^1.3.12",
    "typescript": "^5.6.0"
  },
  "notes": {
    "system-repo-dependency": "This Domain Package resolves the Kernary engine from the sibling path ../aoe-engine.",
    "ownership": "This repository is the complete reference domain package: Model, Corpus, adapters, MCP and skills. It contains no engine implementation."
  }
}
