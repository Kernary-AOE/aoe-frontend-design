anti-pattern CherryPickingEvidence {
  id: "@community/anti-pattern-cherry-picking-evidence"
  version: "1.0.0"

  label: "Cherry-Picking Evidence"
  domain: frontend-design

  description: "Selecting only the research data points that support a predetermined design direction while ignoring contradictory signals — creating false confidence in a chosen solution while real problems go unaddressed."

  trap: "Design direction was already decided by stakeholders; the desire to appear evidence-based without actually changing direction leads to selectively citing research. Trust in the research practice erodes when the same problems resurface."

  remediation: "Actively look for contradictory signals in all available data before finalizing a recommendation. If research conflicts with the chosen direction, surface the conflict explicitly rather than omitting it."

  related: [
    @community/rule-design-decisions-cite-research,
    @community/rule-align-changes-to-findings,
    @community/principle-evidence-not-aesthetics,
  ]
}
