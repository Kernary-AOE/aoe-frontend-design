check FocusVisible {
  id: "@community/check-focus-visible"
  version: "1.0.0"

  signature: (element: DOMElement) -> bool
  predicate: |
    computedStyle(element, ':focus-visible').outlineStyle != 'none'
    AND computedStyle(element, ':focus-visible').outlineWidth >= 2
    AND wcag-contrast-ratio(outlineColor, adjacentColor) >= 3.0

  domain: accessibility

  description: "Checks that a keyboard-focusable element renders a visible, WCAG-compliant focus indicator when it receives keyboard focus. Verifies: (1) outline is not suppressed, (2) outline is at least 2px wide, (3) outline color achieves 3:1 contrast against adjacent background."

  evidence: @w3c/fact-wcag-focus-contrast
  uses-metric: @community/metric-contrast-ratio

  severity: block

  failure-message: "Element '{element.selector}' has no visible focus indicator or indicator fails contrast. Computed outline: {outline_value}. Add `:focus-visible { outline: 2px solid <accessible-color>; outline-offset: 2px; }`."

  evaluation-method: "automated + manual"

  notes: [
    "Automated check can evaluate `outline` and `box-shadow` CSS; manual check needed for custom SVG overlays or pseudo-element rings.",
    "`:focus` (not `:focus-visible`) is checked for legacy browser fallback — if `:focus-visible` is absent, check `:focus` instead.",
    "Suppression pattern to detect: `*:focus { outline: none }`, `button:focus { outline: 0 }`, `a:focus { outline: none }`.",
  ]

  related: [
    @w3c/fact-wcag-focus-contrast,
    @community/term-focus-ring,
    @community/counter-example-outline-none,
    @community/rule-keyboard-accessible,
  ]

  see-also: [
    @community/rule-focus-visible,
  ]
}
