example LinearKanban {
  id: "@community/example-linear-kanban"
  version: "1.0.0"

  label: "Linear — Kanban Board View"
  url: "https://linear.app"
  observed: "2026-Q1"

  domain: visual-design

  description: "Linear's board view shows columns (Backlog / Todo / In Progress / Done) with subtle column headers and stacked cards. Each card is ~280px wide with 12px padding, showing issue ID, title, assignee avatar (16px), and labels as colored dots. Drag-and-drop uses a faint scale(1.02) lift and a placeholder rectangle at the drop target."

  brand: "linear"
  pattern-applied: "@community/pattern-kanban-board"

  aesthetic-notes: [
    "Column header: 13px/600 white with count badge in #6E7178 (e.g., 'In Progress · 7'); no background fill.",
    "Card: #15161A background, 1px #21232A border, 8px border-radius, 12px padding.",
    "Card title: 13px/500 white, max 2 lines with text-overflow:ellipsis.",
    "Labels as 6px colored dots (red #F2453D, green #00B47D, purple #5E6AD2) — never text labels inside the card.",
    "Drag state: card scales to 1.02, opacity 0.9, casts a 0 8px 24px rgba(0,0,0,0.4) shadow.",
    "Drop placeholder: 1px dashed rgba(94,106,210,0.4) outline at target slot, no fill.",
  ]

  what-to-copy: [
    "Column headers without background fills feel 'lighter' than colored-header kanbans (Trello-style).",
    "Use 6px colored dots for labels, not text chips — saves vertical space and scans faster.",
    "Drag affordance: scale(1.02) + shadow is enough; don't tilt (Trello) or rotate (Asana) — feels gimmicky.",
    "Drop placeholder as a dashed outline communicates 'this is where it lands' without layout shift.",
  ]

  what-to-skip: [
    "The horizontal scroll on >5 columns is jarring; consider collapsing rarely-used columns to 56px-wide rails instead.",
  ]

  screenshot-hint: "scout query: linear kanban board dark cards label dots minimal column headers"

  demonstrates: [
    "Kanban cards don't need visible borders if the gap between cards is generous (~8px).",
    "Iconographic labels (dots) outperform text labels on density-sensitive boards.",
    "Restrained drag animation (scale + shadow only) feels professional vs playful.",
  ]

  related: [
    @community/pattern-kanban-board,
    @community/example-linear-issues-table,
    @community/constraint-reduced-motion,
  ]
}
