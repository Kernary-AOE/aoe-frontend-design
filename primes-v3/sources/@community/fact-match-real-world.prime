fact MatchRealWorld {
  id: "@community/fact-match-real-world"
  version: "1.0.0"

  statement: "Nielsen Heuristic 2 — Match Between System and the Real World: The system should speak the users' language, with words, phrases, and concepts familiar to the user, rather than system-oriented terms. Follow real-world conventions, making information appear in a natural and logical order."

  confidence: proven
  evidence: @nielsen/source-nielsen-1994

  domain: ux-design

  heuristic-number: 2

  examples: [
    "Using 'Trash' or 'Recycle Bin' instead of 'Delete buffer' for file deletion.",
    "Shopping cart metaphor for e-commerce checkout flow.",
    "Calendar date picker that shows month and day names, not Unix timestamps.",
  ]

  violations: [
    "Error messages showing raw stack traces or HTTP status codes to end users.",
    "Form field labeled 'SKU' when the user calls it 'Product Code'.",
    "Technical jargon: 'null pointer', 'CORS error', '404' without translation.",
  ]

  notes: [
    "This heuristic is the basis for plain-language error messages and user-facing copy review.",
    "This fact is a member of @nielsen/taxonomy-10-heuristics.",
  ]

  related: [
    @nielsen/taxonomy-10-heuristics,
    @community/fact-visibility-system-status,
  ]
}
