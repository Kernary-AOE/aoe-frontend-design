method A11yAudit {
  id: "@community/method-a11y-audit"
  version: "1.0.0"

  input:  { artifact: URL | FilePath, wcag-level: "A" | "AA" | "AAA" = "AA" }
  output: {
    violations: A11yViolation[],
    score: 0..100,
    passed: number,
    failed: number,
    manual-required: string[],
    report: string
  }

  domain: accessibility

  description: "A comprehensive accessibility audit combining automated tool analysis (axe-core + Lighthouse) with structured manual checks for keyboard navigation, focus management, and screen reader compatibility."

  uses: [
    @community/step-load-artifact,
    @community/step-run-axe,
    @community/step-check-keyboard-nav,
  ]

  body: [
    // Phase 1: Load
    @community/step-load-artifact(artifact) -> document

    // Phase 2: Automated scan
    @community/tool-axe-core(document.raw, { runOnly: [`wcag2${wcag-level.toLowerCase()}`, 'wcag22aa'] }) -> axe-results
    @community/tool-lighthouse(artifact, { onlyCategories: ['accessibility'] }) -> lh-results

    // Phase 3: Structural checks
    @community/check-contrast-aa on all document.text-elements
    @community/check-focus-visible on all document.interactive-elements
    @community/check-keyboard-reachable on all document.interactive-elements

    // Phase 4: Merge + deduplicate violations
    MERGE axe-results.violations + manual check failures
    DEDUPLICATE by element + criterion
    RANK by impact: critical > serious > moderate > minor

    // Phase 5: Score
    score = lh-results.categories.accessibility.score * 100
    SUBTRACT 5 per critical manual violation, 2 per serious

    // Phase 6: Report
    LIST manual-required items that axe cannot evaluate
    GENERATE markdown report with violation table, score, remediation steps
  ]

  success-criteria: [
    @community/check-contrast-aa,
    @community/check-focus-visible,
  ]

  notes: [
    "Automated tools catch ~57% of issues; manual checks and screen reader testing are required for full coverage.",
    "When wcag-level = 'AAA', add @community/check-contrast-aaa and additional checks.",
  ]

  related: [
    @community/tool-axe-core,
    @community/tool-lighthouse,
    @community/rule-color-contrast,
    @community/rule-keyboard-accessible,
  ]
}
