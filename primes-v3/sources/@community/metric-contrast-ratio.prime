metric ContrastRatio {
  id: "@community/metric-contrast-ratio"
  version: "1.0.0"

  name: "wcag-contrast-ratio"
  unit: "ratio (unitless)"
  domain: accessibility

  description: "The WCAG-specified luminance contrast ratio between a foreground color and a background color. Used to assess whether text and UI components meet accessibility thresholds."

  formula: "(L1 + 0.05) / (L2 + 0.05)"

  variables: {
    L1: "relative luminance of the lighter color (0.0–1.0)"
    L2: "relative luminance of the darker color (0.0–1.0)"
  }

  sub-formula: {
    label: "relative-luminance"
    description: "Per WCAG 2.2 definition of relative luminance from IEC 61966-2-1:1999"
    body: """
      For each sRGB channel c in [R, G, B]:
        c_linear = c_srgb / 255
        if c_linear <= 0.04045:
          c_lin = c_linear / 12.92
        else:
          c_lin = ((c_linear + 0.055) / 1.055) ^ 2.4
      L = 0.2126 * R_lin + 0.7152 * G_lin + 0.0722 * B_lin
    """
  }

  thresholds: [
    { level: "AA-normal-text",  min: 4.5, criterion: "@w3c/fact-wcag-contrast-aa" }
    { level: "AA-large-text",   min: 3.0, criterion: "@w3c/fact-wcag-contrast-aa" }
    { level: "AAA-normal-text", min: 7.0 }
    { level: "AA-ui-component", min: 3.0, criterion: "@w3c/fact-wcag-contrast-aa" }
    { level: "focus-ring",      min: 3.0, criterion: "@w3c/fact-wcag-focus-contrast" }
  ]

  range: { min: 1.0, max: 21.0 }

  notes: [
    "A ratio of 1:1 means no contrast (identical colors); 21:1 is maximum (black on white).",
    "The APCA (Advanced Perceptual Contrast Algorithm) is a proposed successor with better perceptual accuracy; not yet normative in WCAG.",
  ]

  related: [
    @w3c/fact-wcag-contrast-aa,
    @community/check-contrast-aa,
    @community/transform-rgb-to-oklch,
  ]
}
