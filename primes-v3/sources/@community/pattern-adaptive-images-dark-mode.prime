pattern AdaptiveImagesDarkMode {
  id: "@community/pattern-adaptive-images-dark-mode"
  version: "1.0.0"

  label: "Adaptive Images for Dark Mode via <picture> Element"
  domain: frontend-design

  problem: "Logos, illustrations, and decorative images designed for light backgrounds become invisible, glaring, or aesthetically wrong when a dark-mode palette is applied. CSS `filter: invert()` is a blunt workaround that breaks color fidelity and ignores brand intent."

  solution: "Use the HTML <picture> element with a <source srcset> carrying a `media='(prefers-color-scheme: dark)'` attribute to serve a purpose-built dark variant. The fallback <img> serves the light version."

  structure: """
    <!-- Adaptive image: serves dark variant when dark mode is active -->
    <picture>
      <source
        srcset="/assets/logo-dark.svg"
        media="(prefers-color-scheme: dark)"
      >
      <img
        src="/assets/logo-light.svg"
        alt="Company logo"
        width="120"
        height="40"
      >
    </picture>

    <!-- Same pattern for photographs that need a different crop/exposure -->
    <picture>
      <source
        srcset="/assets/hero-dark.webp"
        media="(prefers-color-scheme: dark)"
      >
      <img
        src="/assets/hero-light.webp"
        alt="Product hero illustration"
        loading="lazy"
        decoding="async"
      >
    </picture>
  """

  use-when: [
    "a logo, illustration, or icon looks invisible or harsh against a dark background",
    "a decorative hero image needs a different exposure, crop, or color treatment in dark mode",
    "a branded screenshot or mockup contains white backgrounds that break against dark surfaces",
    "an SVG illustration uses hardcoded fill values inappropriate for dark backgrounds",
  ]

  notes: [
    "The <source> media query fires on the OS/browser color scheme preference — it is independent of any JS-based theme toggle. For JS-toggled themes, set the srcset via JS or use CSS background-image with CSS custom properties instead.",
    "For SVGs that only need color adjustments (no structural change), prefer CSS currentColor and CSS custom properties inside the SVG over serving two files.",
    "Always include width and height on the fallback <img> to avoid layout shift (CLS) while the browser resolves the source.",
    "Dark SVG variants should use the brand's dark-mode OKLCH palette stops, not inverted hex values.",
  ]

  related: [
    @community/pattern-color-dark-mode-pairing,
    @community/rule-color-dark-mode-cascade,
    @impeccable/template-oklch-dark-mode-cascade,
    @community/rule-functional-image-alt,
    @community/rule-informative-image-alt,
    @community/check-image-optimization,
    @community/check-focus-visible,
  ]
}
