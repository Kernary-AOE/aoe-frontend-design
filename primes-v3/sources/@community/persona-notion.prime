persona Notion {
  id: "@community/persona-notion"
  version: "1.0.0"

  school: notion
  domain: visual-design

  description: "Warm minimalist workspace brand: NotionInter (modified Inter) on pure white #ffffff with warm-undertone gray scale, Notion Blue #0075de as single saturated accent, whisper borders at rgba(0,0,0,0.1), and multi-layer micro-shadows for depth that is felt rather than seen."

  implies: {
    font: {
      display: "NotionInter (modified Inter, fallbacks: Inter, -apple-system, system-ui, Segoe UI) — OpenType lnum + locl on display/heading text; 64px/700/line-height 1.00/letter-spacing -2.125px for hero"
      body: "NotionInter — 400 body, 500 UI, 600 emphasis, 700 display; scale with progressively relaxing tracking from -2.125px at 64px toward normal at 16px"
      monospace: "NotionInter sans everywhere (Notion uses its sans for code as well); distinct mono typeface not a brand feature"
    }
    color: {
      temperature: "warm-neutral"
      palette: "Notion Blue #0075de CTA/link, near-black rgba(0,0,0,0.95) primary text, white #ffffff canvas, alt-bg #f6f5f4 warm-white (yellow undertone), warm dark surface #31302e, gray-500 #615d59, gray-300 #a39e98, active blue #005bab, deep navy #213183, badge-bg #f2f9ff"
      background: "#ffffff"
    }
    density: "refined-minimal — 4px buttons/inputs, 8px small cards, 12px standard cards, 16px hero cards, 9999px pill badges; 8px base with fractional micro-adjustments (5.6px, 6.4px); 1200px max-width; section rhythm 64–120px vertical"
    layout: "white sections alternating with #f6f5f4 warm-white sections for visual rhythm without harsh color breaks; centered 1200px; playful hand-drawn hero illustrations layered on soft warm gradient backgrounds"
    imagery: "hand-drawn character illustrations and decorative art as hero anchors — not stock photography, not abstract gradients; illustration signals 'canvas for your content'"
    motion: "multi-layer micro-shadows (4–5 stacked layers, max individual opacity 0.05 each) — depth felt rather than seen; whisper border rgba(0,0,0,0.1) throughout"
  }

  compatible: ["notion-warm", "editorial", "warm-institutional", "magazine-editorial"]
  conflicts: ["brutalist", "vercel-clean", "dense-pragmatist"]

  example-brands: [
    "Notion",
  ]

  notes: [
    "Compressed display: NotionInter 64px/700 with -2.125px letter-spacing, progressively relaxing to normal at 16px — the tracking progression is the typography system's defining move.",
    "Whisper borders rgba(0,0,0,0.1) throughout — division lines exist as barely-perceptible structure; heavy borders break the 'quality paper' impression.",
    "Multi-layer micro-shadows: 4–5 stacked shadow layers where each individual shadow opacity never exceeds 0.05 (e.g. rgba(0,0,0,0.04) + rgba(0,0,0,0.027) + ...) — depth that is felt, not measured.",
    "Warm neutral gray scale carries yellow-brown undertones (#f6f5f4 alt-bg, #615d59 secondary, #a39e98 muted) — 'quality paper, not sterile glass'; cool grays would immediately break the brand warmth.",
    "Playful hand-drawn hero illustrations on soft warm gradient backgrounds are a deliberate brand signal: the product is a canvas users bring their own content to, not a tool that imposes its voice.",
    "Use for document-centric, creator-facing, or content-management products where the design must feel approachable but refined. Avoid for data-heavy analytics — whisper borders and warm alternation don't hold density well.",
    "Distinct from @impeccable/persona-notion-warm: this is the actual notion.so brand reference with specific hex values and OpenType details; persona-notion-warm is the generic warm-tooling school inspired by it — use persona-notion for 'Notion-exact', persona-notion-warm for the broader aesthetic category.",
  ]

  composition: {
    must-include: [
      @community/pattern-card-component,
      @impeccable/template-card-hover-lift,
    ]
    must-avoid: [
      @impeccable/persona-brutalist,
      @community/anti-pattern-thin-weight-body,
    ]
    typography-required: {
      display: "NotionInter (modified Inter)"
      weight-range: "400-700"
      tracking: "-2.125px at 64px, relaxing to normal at 16px"
    }
    color-required: {
      background: "#ffffff"
      alt-bg: "#f6f5f4"
      accent: "#0075de"
    }
    motion-prescriptions: [
      @impeccable/template-card-hover-lift,
      @community/pattern-hover-lift,
    ]
  }

  related: [
    @impeccable/persona-notion-warm,
    @impeccable/template-oklch-palette,
    @impeccable/template-card-hover-lift,
    @community/principle-typography-hierarchy,
    @community/check-line-length-optimal,
    @community/rule-opentype-features-on,
    @community/rule-typography-letter-spacing,
    @community/fact-line-height-readability,
    @community/check-body-readability,
    @community/principle-color-system-foundation,
    @community/check-color-oklch-required,
    @community/check-contrast-aa,
    @community/rule-single-accent-color,
    @community/constraint-no-pure-white-bg,
    @community/rule-backgrounds-atmospheric,
    @community/anti-pattern-generic-saas-blue,
    @community/check-color-blacklist-brand,
  ]

  contradicts: [
    @impeccable/persona-brutalist,
    @community/anti-pattern-thin-weight-body,
  ]
}
