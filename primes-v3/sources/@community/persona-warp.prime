persona Warp {
  id: "@community/persona-warp"
  version: "1.0.0"

  school: warp
  domain: visual-design

  description: "Warm-dark developer lifestyle aesthetic: Matter Regular at weight 400 even on headlines, near-black canvas with earthy warm-gray undertones (not cold blue-black), #faf9f6 Warm Parchment text, and nature photography interleaved with terminal screenshots — the campfire dev tool."

  implies: {
    font: {
      display: "Matter Regular (Matter SQ Regular for select display) with fallbacks system sans"
      body: "Matter Regular weight 400 — same weight for headlines and body, hierarchy from size only"
      monospace: "Geist Mono (display mono) and Matter Mono Regular (body mono)"
    }
    color: {
      temperature: "warm-neutral"
      palette: "primary text #faf9f6 Warm Parchment, button bg #353534 Earth Gray, borders/dark #454545 / #353534 Dark Charcoal, body reading #afaeac Ash Gray, secondary text #868584 Stone Gray, tertiary #666469 Muted Purple-Tint Gray, surface rgba(255,255,255,0.04) Frosted Veil, card border rgba(226,226,226,0.35) Mist Border"
      background: "near-black with earthy warm-gray undertones — no single hex, warm canvas not cold blue-black"
    }
    density: "cinematic — 8px base spacing, 80–120px section padding, ~1500px max-width (wide for photography), radius 4–6px small / 8px images+cards / 12–14px feature cards / 50px pill CTAs"
    layout: "wide 1500px cinematic canvas, nature photography interleaved with terminal UI screenshots, editorial uppercase label categorization, sections feel like magazine spreads"
    imagery: "golden-hour forests and landscapes interleaved with product terminal screenshots — unique lifestyle-dev visual language; no stock photography"
    motion: "contemplative — no accent colors to animate; hover via ghostly border transitions rgba(226,226,226,0.35); no bounce, no urgency"
  }

  compatible: ["editorial", "warm-institutional", "magazine-editorial", "notion-warm"]
  conflicts: ["dense-pragmatist", "brutalist", "stripe-fintech", "swiss-modernist"]

  example-brands: [
    "Warp",
  ]

  notes: [
    "The warm-not-cold dark canvas is the entire brand differentiator — earthy warm-gray undertones vs blue-black; text #faf9f6 cream not pure white. Losing the warmth collapses it into generic dev-tool dark.",
    "Matter Regular weight 400 on all headlines — typography hierarchy is size-only, weight never. Using Medium or Bold immediately breaks the calm, even texture.",
    "Editorial uppercase labels: 12–14px Matter Regular, uppercase transform, positive 1.4–2.4px letter-spacing — magazine categorization signaling editorial pacing not tech urgency.",
    "No shadows — card containment from rgba(226,226,226,0.35) ghostly Mist Border at ~35% opacity; barely visible but structurally essential.",
    "Dark pill CTAs at 50px radius: #353534 bg with #afaeac text — restrained, muted, never bright. This is the only CTA style; bright accent buttons don't exist in this persona.",
    "Nature photography (golden-hour forests) between terminal screenshots is the persona's most distinctive content pattern — remove it and it reads as a generic warm dark dev site.",
    "Use for dev tools needing warmth and emotional resonance, lifestyle-tech blend, calm productivity. Avoid when brand needs conversion urgency or high saturation.",
  ]

  composition: {
    must-include: [
      @impeccable/template-easing-curves,
      @impeccable/template-oklch-dark-mode-cascade,
      @community/principle-typography-hierarchy,
    ]
    must-avoid: [
      @impeccable/persona-dense-pragmatist,
      @impeccable/persona-brutalist,
    ]
    typography-required: {
      display: "Matter Regular (weight 400 on ALL headings)"
      size-only-hierarchy: true
      uppercase-labels: "12-14px, +1.4-2.4px tracking"
    }
    color-required: {
      background: "near-black warm earthy undertones (no single hex)"
      text-primary: "#faf9f6"
      border-style: "rgba(226,226,226,0.35) (no shadows)"
    }
    motion-prescriptions: [
      @impeccable/template-easing-curves,
      @community/pattern-hover-lift,
    ]
  }

  related: [
    @impeccable/persona-editorial,
    @impeccable/template-easing-curves,
    @impeccable/template-oklch-palette,
    @community/principle-typography-hierarchy,
    @community/check-line-length-optimal,
    @community/fact-monospace-purpose,
    @community/rule-typography-letter-spacing,
    @community/check-body-readability,
    @impeccable/template-oklch-dark-mode-cascade,
    @community/pattern-color-dark-mode-pairing,
    @community/principle-color-system-foundation,
    @community/check-color-dark-mode-cascade,
    @community/check-contrast-aa,
    @community/constraint-no-pure-white-bg,
    @community/rule-backgrounds-atmospheric,
    @community/anti-pattern-generic-saas-blue,
    @community/check-color-blacklist-brand,
  ]

  contradicts: [
    @impeccable/persona-dense-pragmatist,
    @impeccable/persona-brutalist,
  ]
}
