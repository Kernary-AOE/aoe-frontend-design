principle SharedVisualLanguage {
  id: "@community/principle-shared-visual-language"
  version: "1.0.0"

  domain: frontend-design

  description: "Color tokens, typography roles, spacing scale, and iconography must come from a shared design token system used consistently across all platforms, so the product feels visually unified even when interaction patterns differ per platform."

  claim: "A product spanning multiple platforms MUST share a single token system for color (brand, semantic, neutrals), typography (role-based scale: display, heading, body, caption), and spacing — platform-specific implementations consume the same tokens; they do not invent new values."

  rationale: "Without shared tokens, platform teams drift apart over time: slightly different blues, different border radii, different type sizes for 'heading'. The product loses visual coherence. Shared tokens maintain coherence while allowing platform-specific rendering."

  token-categories: {
    color: [
      "Brand: --color-brand-500 (primary), --color-brand-600 (hover)",
      "Semantic: --color-error, --color-success, --color-warning, --color-info",
      "Neutral: --color-neutral-0 through --color-neutral-1000",
      "Surface: --color-surface-base, --color-surface-raised, --color-surface-overlay",
    ]
    typography: [
      "Roles: display, heading-l, heading-m, heading-s, body-l, body-m, body-s, caption, label",
      "Each role has: font-family, font-size, line-height, font-weight, letter-spacing",
    ]
    spacing: [
      "Base-4 or base-8 scale: 4, 8, 12, 16, 24, 32, 40, 48, 64, 80, 96",
    ]
    iconography: [
      "Single icon library used across all platforms (e.g. Lucide, Phosphor)",
      "Platform-specific icons (iOS SF Symbols, Android Material Icons) are additive, not replacements",
    ]
  }

  implementation: [
    "Web: CSS custom properties from a generated token file.",
    "iOS: Swift constants or ColorAsset catalog generated from the same source.",
    "Android: res/values/colors.xml generated from the same source.",
    "Source of truth: a platform-agnostic JSON/YAML token file (Style Dictionary or equivalent).",
  ]

  related: [
    @community/principle-consistent-cross-platform-mental-models,
    @community/principle-color-system-foundation,
    @community/rule-color-oklch-required,
    @community/anti-pattern-rainbow-explosion,
    @community/example-shadcn-settings,
    @community/example-tailwindui-app-shell,
    @community/rule-no-mixed-visual-languages,
    @community/rule-consistent-design-token-scale,
  ]
}
