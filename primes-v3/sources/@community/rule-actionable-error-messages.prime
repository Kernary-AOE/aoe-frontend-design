rule ActionableErrorMessages {
  id: "@community/rule-actionable-error-messages"
  version: "1.0.0"

  domain: frontend-design
  severity: warning

  statement: "Error and success messages must be actionable and tied to the specific context in which they appear — telling the user what happened AND what to do next. Generic messages ('Something went wrong', 'Success') are prohibited."

  applies-when: "Writing or reviewing any error, validation, or success feedback in a UI."

  verify-by: "Confirm each message names the specific event and offers at least one next step. Reject messages that only describe state without direction."

  anti-pattern: "Generic context-free messages force users to guess what went wrong and how to recover, increasing abandonment rates. Examples of banned messages: 'An error occurred', 'Operation failed', 'Done'."

  use-instead: [
    "'Email already in use — try signing in or use a different email'",
    "'Payment failed — check your card number and expiry, then try again'",
    "'Report saved — view it in your Reports dashboard'",
  ]

  related: [
    @community/principle-error-prevention-and-recovery,
    @community/rule-active-voice-in-ui-copy,
    @community/principle-nielsen-error-recovery,
    @community/anti-pattern-generic-error-text,
    @community/example-stripe-checkout,
    @community/rule-preserve-user-input-on-error,
    @community/principle-tone-calibration,
  ]
}
