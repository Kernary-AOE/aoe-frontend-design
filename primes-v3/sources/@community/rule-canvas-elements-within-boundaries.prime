rule CanvasElementsWithinBoundaries {
  id: "@community/rule-canvas-elements-within-boundaries"
  version: "1.0.0"

  domain: frontend-design
  severity: block

  statement: "Every text, graphic, and visual element in a canvas art output (.pdf or .png) must remain within canvas boundaries with proper margins. No elements may be clipped by the canvas edge. No two elements may overlap. All elements must have visible breathing room from adjacent elements."

  applies-when: "Generating any static canvas art, poster, or print-format design artifact."

  verify-by: "Nothing falls off the canvas edge. No two elements overlap. All elements have clear separation from adjacent elements."

  rationale: "Elements clipped by canvas edges or overlapping others signal careless execution and ruin professional presentation. This is a non-negotiable baseline for professional quality — not an aesthetic preference."

  sources: [
    "Anthropic canvas-design SKILL.md — Canvas Creation section",
  ]

  related: [
    @community/rule-canvas-visual-text-ratio,
    @community/principle-design-philosophy-before-canvas,
  ]
}
