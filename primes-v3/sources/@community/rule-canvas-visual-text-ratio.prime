rule CanvasVisualTextRatio {
  id: "@community/rule-canvas-visual-text-ratio"
  version: "1.0.0"

  domain: frontend-design
  severity: warning

  statement: "Static art and poster outputs must allocate approximately 90% of their composition to visual design and at most 10% to text. Outputs with text above 25% of composition area are rejected — they are documents, not art."

  applies-when: "Generating any .pdf or .png canvas art or poster."

  thresholds: {
    pass: "text <= 10%"
    warn: "text 10-25%"
    block: "text > 25%"
  }

  rationale: "Canvas art communicates through visual design; excessive text shifts the artifact from art to document. A poster with 50% text is a text document with decorative margins. The 90/10 rule enforces that the primary communication vehicle is visual."

  sources: [
    "Anthropic canvas-design SKILL.md — Critical Understanding section",
  ]

  related: [
    @community/rule-canvas-elements-within-boundaries,
    @community/principle-design-philosophy-before-canvas,
  ]
}
