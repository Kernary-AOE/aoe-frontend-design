rule CrossPlatformFlowStepConsistency {
  id: "@community/rule-cross-platform-flow-step-consistency"
  version: "1.0.0"

  domain: frontend-design

  description: "Multi-step flows (onboarding, checkout, account setup) must present the same steps in the same logical order across all platforms, even if visual grouping or layout differs per platform."

  claim: "The step sequence of a multi-step user flow MUST be identical across all platforms — steps may be visually grouped differently (e.g. two mobile steps collapsed into one desktop screen) but the logical order must remain the same and no step may be omitted on one platform without being omitted on all."

  severity: warning

  rationale: "Users who start a flow on web and continue on mobile (or vice versa) depend on step order being consistent to orient themselves. Omitting or reordering steps between platforms creates confusion and support burden."

  examples: {
    good: "Onboarding: (1) Account → (2) Profile → (3) Team → (4) Billing. Desktop groups 1+2 on one screen; mobile shows them as separate steps. Same logical sequence."
    bad: "Web onboarding: Account → Profile → Billing. iOS onboarding: Account → Billing (Profile step missing). Users who started on web are confused when resuming on iOS."
  }

  behavior: [
    "Map all flows across platforms to a shared step model before building.",
    "If a platform groups multiple logical steps on one screen, the URL/state still reflects each logical step.",
    "If a step must be omitted on a platform (e.g. billing handled differently on App Store), document the exception and provide an equivalent path.",
  ]

  related: [
    @community/principle-consistent-cross-platform-mental-models,
    @community/rule-no-divergent-platform-flows,
    @community/pattern-multi-step-wizard,
  ]
}
