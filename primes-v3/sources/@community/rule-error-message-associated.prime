rule ErrorMessageAssociated {
  id: "@community/rule-error-message-associated"
  version: "1.0.0"

  applies-to: @community/type-html-artifact

  domain: accessibility

  description: "Every form-validation error message MUST be programmatically associated with its field via `aria-describedby`, AND the field MUST set `aria-invalid='true'`. Visually-adjacent error text without programmatic association is invisible to screen readers."

  claim: "Every visible error message attached to a form field MUST be referenced by that field's `aria-describedby`, and the field MUST carry `aria-invalid='true'` while the error is present."

  severity: critical

  validates-with: [
    @w3c/source-wcag-22,
  ]

  checks: [
    @community/check-error-message-associated,
  ]

  severity-combination: |
    error visible, no aria-describedby                   → BLOCK  (SC 1.3.1, 3.3.1)
    error visible, no aria-invalid                       → WARN
    error has both aria-describedby and aria-invalid     → PASS

  failure-mode: "Screen-reader users hear the field name and value but no indication an error exists; they submit the form again with the same data and the same failure. WCAG Level A fails."

  remediation: [
    "Render: `<input id='email' aria-describedby='email-error' aria-invalid='true'>` `<p id='email-error' role='alert'>Enter a valid email.</p>`.",
    "Toggle `aria-invalid` to `false` (or remove) when the user corrects the value — don't leave stale state.",
    "Use `role='alert'` (or `aria-live='polite'`) on the error region so the message is announced when it appears, not on next focus.",
    "If a field has both a hint and an error, set `aria-describedby='email-hint email-error'` (space-separated).",
  ]

  exceptions: [
    {
      case: "Server-side post-submit error page",
      allowed-when: "A full re-render of the form with errors injected as adjacent text is acceptable IF aria-describedby is wired on render.",
    }
  ]

  notes: [
    "An empty error region (`<p id='email-error'></p>`) is safe — when the message appears, the live region announces it. But the `id` must always exist for `aria-describedby` to resolve.",
    "Pair with @community/rule-form-validation-inline so errors actually appear at the right time.",
  ]

  related: [
    @community/rule-form-validation-inline,
    @community/rule-form-label-associated,
    @community/rule-aria-label-required,
    @impeccable/template-form-validation,
  ]

  see-also: [
    @community/check-error-message-associated,
  ]
}
