rule IosLaunchScreenMatch {
  id: "@community/rule-ios-launch-screen-match"
  version: "1.0.0"

  domain: frontend-design

  applies-to: "iOS LaunchScreen.storyboard / launch screen configuration"

  statement: "The launch screen must visually replicate the app's initial view rather than showing a logo or branding screen."

  rationale: "A matched launch screen creates the perception of instant launch — the transition from launch screen to first view feels seamless. Branding/logo splash screens add artificial delay, feel dated, and are explicitly discouraged by Apple HIG Rule 8.3."

  examples: [
    "Show the skeleton of the home tab (navigation bar, tab bar, placeholder rows) in the launch storyboard so the real view loads over it imperceptibly.",
    "Anti-example: full-screen app logo on a branded background color that disappears before the real UI appears.",
  ]

  notes: [
    "Applies when: configuring the iOS LaunchScreen.storyboard or the launch screen configuration in Xcode.",
    "Verify by: cold-launching the app; the transition from launch screen to first view should feel instantaneous with no visual jump.",
    "Apple HIG source: Rule 8.3 — Launch Screen, Match First Screen; Anti-Pattern #4.",
  ]

  related: [
    @community/rule-mobile-first,
    @community/anti-pattern-ios-fullscreen-spinner,
    @community/pattern-ios-large-title-nav,
  ]
}
