rule IosSfSymbolsTabBar {
  id: "@community/rule-ios-sf-symbols-tab-bar"
  version: "1.0.0"

  domain: frontend-design

  applies-to: "all tab bar item icon assignments in iOS apps"

  statement: "Tab bar icons must use SF Symbols; the selected tab displays the filled variant (e.g., 'house.fill') and unselected tabs display the outline variant (e.g., 'house')."

  rationale: "The fill/outline distinction is the iOS-native affordance for indicating selected state in tab bars. It is the pattern used consistently across all system apps (App Store, Music, Health, etc.) and is immediately understood by iOS users without additional visual cues."

  examples: [
    "TabItem: selected → Image(systemName: 'house.fill'), unselected → Image(systemName: 'house').",
    "In SwiftUI TabView, set the .tabItem label with the correct symbol name per selected state — SwiftUI handles this via the selection binding.",
    "Verify: tap each tab; selected icon must be filled, all others must be outlined.",
  ]

  notes: [
    "SwiftUI TabView automatically switches between filled/outline if you provide both in the .tabItem using Image(systemName: 'house.fill') and the tab selection drives the fill state.",
    "Apple HIG source: Rule 7.5 — Tab Bar Behavior.",
  ]

  related: [
    @community/pattern-ios-tab-bar-top-level,
    @community/rule-ios-tab-bar-always-visible,
    @community/fact-ios-sf-symbols-rendering-modes,
  ]
}
