rule NoNewVisualPrimitives {
  id: "@community/rule-no-new-visual-primitives"
  version: "1.0.0"

  domain: frontend-design

  description: "New colors, fonts, or icon families not grounded in the existing token system must not be introduced without explicit token extension — raw visual primitive values outside the token layer are forbidden."

  claim: "Hardcoded color hex/rgb values, new font-family references, and new icon library imports are forbidden unless they are simultaneously added to the token system."

  severity: high

  rationale: "Each undocumented primitive is a design debt entry: it will diverge from the system in dark mode, rebrand, or handoff. Tokens make primitives queryable, replaceable, and auditable."

  forbidden: [
    "color: #e85d2f — raw hex outside token system",
    "font-family: 'Playfair Display' — new font import without token",
    "Importing a second icon library alongside the existing one without migration plan",
    "box-shadow: 0 4px 20px rgba(0,100,255,0.3) — novel shadow outside elevation scale",
  ]

  correct: [
    "color: var(--color-accent-600) — token reference",
    "Adding --font-display: 'Playfair Display' to tokens.css AND updating the token docs",
  ]

  related: [
    @community/rule-consistent-design-token-scale,
    @community/rule-no-mixed-visual-languages,
    @community/anti-pattern-magic-numbers,
  ]
}
