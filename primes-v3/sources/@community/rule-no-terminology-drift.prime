rule NoTerminologyDrift {
  id: "@community/rule-no-terminology-drift"
  version: "1.0.0"

  domain: frontend-design

  description: "A concept must be named identically throughout a single user flow — switching between synonyms or related terms mid-flow (e.g., 'Workspace' → 'Project' → 'Team') is forbidden."

  claim: "Within any single user flow, every instance of a named concept must use exactly the same label — term variation within a flow is prohibited."

  severity: medium

  rationale: "Term inconsistency forces users to mentally track whether 'Workspace', 'Project', and 'Team' are the same thing. This creates cognitive overhead and leads to errors, especially in multi-step flows where users carry context from prior steps."

  examples: [
    "Violation: step 1 says 'Create a Project', step 3 says 'Your Workspace is ready'",
    "Violation: button says 'Delete Account', confirmation dialog says 'Remove Profile'",
    "Correct: create a terminology glossary before building; freeze labels at design system level",
  ]

  related: [
    @community/rule-consistent-product-terminology,
    @community/rule-no-undocumented-platform-concept-rename,
    @community/principle-nielsen-consistency,
  ]
}
