rule OpentypeFeaturesOn {
  id: "@community/rule-opentype-features-on"
  version: "1.0.0"

  applies-to: "@community/type-html-artifact"

  domain: frontend-design

  description: "By default, browsers activate only a small subset of OpenType features; production CSS MUST explicitly enable `kern` (kerning), `liga` (standard ligatures), and numeric figure features (`tnum`/`lnum`) at minimum — and SHOULD activate stylistic sets `ss01` or character variants `cv01` where the brand typeface ships them."

  claim: "All shipped CSS MUST include at minimum `font-kerning: auto` and `font-variant-ligatures: common-ligatures` on the root element; any numeric display context MUST set `font-variant-numeric: tabular-nums lining-nums`."

  severity: medium

  applies-to-details: [
    "Root CSS that sets the base font-family",
    "Any context displaying financial / tabular numbers",
    "Editorial / marketing contexts where brand typeface ships ss01 / cv01",
  ]

  remediation: [
    "Root: `html { font-kerning: auto; font-variant-ligatures: common-ligatures; }`",
    "Numerics: `.amount, td, .metric { font-variant-numeric: tabular-nums lining-nums; }`",
    "Brand stylistic sets: check font specimen; activate via `font-feature-settings: 'ss01' 1;`",
    "OpenType code reference: kern (kerning), liga (standard ligatures), tnum (tabular figures), lnum (lining figures), onum (oldstyle figures), pnum (proportional figures), ss01–ss20 (stylistic sets), cv01–cv99 (character variants).",
  ]

  related: [
    @community/rule-font-feature-settings,
    @community/fact-optical-sizing,
    @community/fact-monospace-purpose,
  ]
}
