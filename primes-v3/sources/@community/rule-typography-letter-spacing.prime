rule TypographyLetterSpacing {
  id: "@community/rule-typography-letter-spacing"
  version: "1.0.0"

  applies-to: "@community/type-html-artifact"

  domain: frontend-design

  description: "Letter-spacing MUST follow size-dependent rules: display text (36px+) uses -0.02em to -0.04em to counteract optical spread; body text (14–20px) uses 0em (no tracking); small UI labels and uppercase abbreviations (10–13px) use +0.04em to +0.1em; ALL-CAPS labels always require +0.05em minimum."

  claim: "Author CSS MUST NOT apply positive letter-spacing to body prose, negative letter-spacing to body prose below 20px, or use ALL-CAPS text without compensating letter-spacing of at least +0.05em."

  severity: medium

  rationale: "Letter-spacing is an optical compensation tool, not a decoration. At display sizes, letters are spaced too loosely by the font's built-in metrics relative to the visual weight of large glyphs — tightening restores balance. At body sizes, the font's built-in tracking is calibrated for reading; adding tracking interferes with natural rhythm. ALL-CAPS text loses inter-letter kerning pairs designed for mixed-case reading, requiring explicit tracking to restore legibility."

  quantitative: {
    display-large: "-0.02em to -0.04em (48px+)",
    display-medium: "-0.01em to -0.02em (36–48px)",
    body-prose: "0em (14–20px — never add tracking)",
    small-labels: "+0.04em to +0.08em (11–13px)",
    all-caps: "+0.05em minimum (any size)",
    uppercase-abbreviations: "+0.08em to +0.12em (short UPPERCASE strings)",
  }

  remediation: [
    "Display headings: `h1 { letter-spacing: -0.025em; }`",
    "ALL-CAPS badges: `.badge-uppercase { text-transform: uppercase; letter-spacing: 0.08em; }`",
    "Body: never set letter-spacing on `p`, `.prose`, `article` — remove any tracking declaration.",
    "Use em units (not px) so tracking scales proportionally with font-size.",
  ]

  related: [
    @community/fact-optical-sizing,
    @community/rule-body-readability,
    @community/check-body-readability,
    @community/anti-pattern-thin-weight-body,
    @community/example-linear-issues-table,
    @community/rule-uppercase-labels-tracking,
    @community/principle-typography-hierarchy,
  ]
}
