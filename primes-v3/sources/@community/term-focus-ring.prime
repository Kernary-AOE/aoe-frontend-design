term FocusRing {
  id: "@community/term-focus-ring"
  version: "1.0.0"

  meaning: "The visible outline or other visual indicator that marks which UI element currently holds keyboard focus, enabling sighted keyboard users to track their position in the interface."

  domain: accessibility

  aliases: ["focus indicator", "focus outline", "focus style"]

  notes: [
    "CSS property `outline` is the canonical implementation; `box-shadow` is a common progressive-enhancement alternative.",
    "`:focus-visible` pseudo-class targets keyboard focus only (excludes mouse click), the preferred selector since Chrome 86 / Firefox 85 / Safari 15.4.",
    "`:focus` targets ALL focus events including mouse; avoid styling only `:focus` since it causes visible rings on mouse-click, which many designers suppress — breaking keyboard navigation.",
    "Suppressing outlines with `outline: none` or `outline: 0` without a custom alternative violates WCAG SC 2.4.11.",
  ]

  related: [
    @w3c/fact-wcag-focus-contrast,
    @community/check-focus-visible,
    @community/value-focus-outline-width,
  ]
}
