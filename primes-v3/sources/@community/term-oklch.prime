term Oklch {
  id: "@community/term-oklch"
  version: "1.0.0"

  meaning: "A perceptually-uniform polar color space (Lightness, Chroma, Hue) built on the Oklab color model, standardized in CSS Color Level 4. Each channel has an intuitive meaning: L (0–1) is perceived lightness; C (≈ 0–0.4) is perceived chroma/saturation; H (0–360°) is hue angle."

  domain: visual-design

  aliases: ["oklch()", "OK LCH", "perceptual polar color"]

  notes: [
    "Unlike HSL, adjusting L in oklch() changes perceived brightness without shifting perceived hue — palettes generated by fixing C+H and varying L are perceptually even-stepped.",
    "oklch() is natively supported in CSS Color Level 4; browser support: Chrome 111+, Firefox 113+, Safari 15.4+ (with `color()` fallback for older).",
    "Chroma values above ~0.37 may fall outside the sRGB gamut on standard displays; use `@supports (color: oklch(0 0 0))` with `color-mix()` clamp or P3 media query.",
    "Recommended for design tokens: generate a full tonal palette by fixing C+H, varying L from 0.15 to 0.95 in steps.",
    "Human-readable design intent is preserved: 'warm orange at medium lightness' = oklch(62% 0.17 42).",
  ]

  related: [
    @community/value-brand-hue,
    @impeccable/template-oklch-palette,
    @community/transform-rgb-to-oklch,
  ]

  supplies-to: [
    @community/constraint-oklch-only-color,
  ]
}
