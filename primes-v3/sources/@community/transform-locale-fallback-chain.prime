transform LocaleFallbackChain {
  id: "@community/transform-locale-fallback-chain"
  version: "1.0.0"

  signature: (requested: string, available: string[]) -> string[]
  pure: true

  domain: i18n

  description: "Computes the BCP 47 locale fallback chain for a requested locale tag. Implements RFC 4647 'Lookup' algorithm: try the most specific tag, then truncate subtags from the right, fall through to a default. Critical for graceful degradation when a translation file is missing."

  body: """
    /**
     * Compute fallback chain for a BCP 47 locale tag.
     *
     * Examples:
     *   localeFallbackChain('zh-Hant-HK', ['en', 'zh-Hans', 'zh-Hant', 'zh-Hant-HK'])
     *     → ['zh-Hant-HK', 'zh-Hant', 'en']
     *
     *   localeFallbackChain('en-US', ['en', 'fr'])
     *     → ['en-US', 'en']
     *
     *   localeFallbackChain('xx-YY', ['en', 'fr'])
     *     → ['en'] (final default)
     */
    function localeFallbackChain(requested, available, defaultLocale = 'en') {
      if (typeof requested !== 'string' || requested.length === 0) {
        throw new TypeError('requested must be a non-empty BCP 47 tag');
      }
      if (!Array.isArray(available) || available.length === 0) {
        throw new TypeError('available must be a non-empty array');
      }

      const norm = s => s.toLowerCase();
      const availableSet = new Set(available.map(norm));
      const chain = [];
      const seen = new Set();

      // Try requested, then truncate by hyphen from the right
      let tag = requested;
      while (tag.length > 0) {
        const normTag = norm(tag);
        if (availableSet.has(normTag) && !seen.has(normTag)) {
          // Preserve the original case from `available` array
          const preserved = available.find(a => norm(a) === normTag);
          chain.push(preserved);
          seen.add(normTag);
        }
        const lastHyphen = tag.lastIndexOf('-');
        if (lastHyphen === -1) break;
        tag = tag.substring(0, lastHyphen);
        // RFC 4647: skip private-use sequences and single-letter subtags
        const next = tag.substring(0, tag.lastIndexOf('-'));
        if (tag.length - next.length === 2 && next.length > 0) {
          tag = next;
        }
      }

      // Append default if not already in chain
      if (!seen.has(norm(defaultLocale))) {
        const preservedDefault = available.find(a => norm(a) === norm(defaultLocale));
        if (preservedDefault) {
          chain.push(preservedDefault);
        }
      }

      return chain;
    }
  """

  examples: [
    { input: { requested: "zh-Hant-HK", available: ["en", "zh-Hans", "zh-Hant", "zh-Hant-HK"] }, output: "['zh-Hant-HK', 'zh-Hant', 'en']" }
    { input: { requested: "en-US", available: ["en", "fr"] }, output: "['en-US', 'en']" }
    { input: { requested: "fr-CA", available: ["fr-FR", "fr", "en"] }, output: "['fr', 'en']" }
    { input: { requested: "xx-YY", available: ["en", "fr"] }, output: "['en']" }
  ]

  inverse: null

  notes: [
    "Implements RFC 4647 'Lookup' filtering. The 'Basic Filtering' (RFC 4647 §3.3.1) is similar but returns ALL matches rather than a single best match.",
    "Browsers do this internally for `<html lang>` matching against installed font fallbacks and for CSS `:lang()` selectors.",
    "JavaScript: `Intl.getCanonicalLocales(['zh-hant-hk'])` → `['zh-Hant-HK']` normalizes case and subtag order. Use BEFORE this transform.",
    "Most i18n libraries (react-intl, i18next, FormatJS) include their own locale resolution; use this transform when building custom resolution.",
    "Fallback chain length is typically 1-4 items; pathological inputs cap at ~10 (max BCP 47 subtag depth).",
    "Edge case: 'es-419' (Latin America) does NOT fall back to 'es' under strict RFC 4647 — it falls to 'es-419' or default. Most apps deliberately allow es-419 → es.",
  ]

  related: [
    @community/type-locale-tag,
    @community/rule-intl-api-locale-formatting,
    @community/principle-no-string-concat,
    @community/pattern-icu-message-format,
    @community/transform-px-to-rem,
  ]
}
