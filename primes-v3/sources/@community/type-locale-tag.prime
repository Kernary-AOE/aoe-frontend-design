type LocaleTag {
  id: "@community/type-locale-tag"
  version: "1.0.0"

  domain: i18n

  description: "Schema for a locale identifier conforming to BCP 47 (RFC 5646), the IETF standard for language tags. A locale tag combines language, optional script, optional region, and optional variants (e.g. 'en-US', 'zh-Hant-HK', 'sr-Cyrl', 'pt-BR')."

  fields: {
    language: {
      type: string
      format: "ISO 639-1 two-letter or ISO 639-3 three-letter code, lowercase: 'en', 'zh', 'pt', 'haw'"
      required: true
    }
    script: {
      type: "string | null"
      format: "ISO 15924 four-letter code, Title Case: 'Hans', 'Hant', 'Cyrl', 'Latn'"
      description: "Required when the language has multiple writing systems (Chinese, Serbian, Mongolian, Uzbek)."
      required: false
    }
    region: {
      type: "string | null"
      format: "ISO 3166-1 alpha-2 two-letter, UPPERCASE: 'US', 'GB', 'BR', 'TW' OR UN M.49 three-digit: '419' (Latin America)"
      description: "Optional regional variant. Required when locale-specific formatting differs (en-US vs en-GB date format)."
      required: false
    }
    variant: {
      type: "string[] | null"
      format: "Up to 8 alphanumeric characters per variant subtag"
      description: "Rarely-used dialect or orthographic variant: 'de-DE-1996' (post-1996 German spelling), 'sl-rozaj' (Resian)"
      required: false
    }
    extension: {
      type: object
      description: "BCP 47 extension subtags — most common is `u` (Unicode locale extension) for calendar/numbers/collation: '-u-ca-buddhist', '-u-nu-arab'"
      shape: "Record<string, string>"
      required: false
    }
    private-use: {
      type: "string | null"
      format: "Begins with 'x-': 'x-internal', 'x-pig-latin'"
      description: "Application-specific tags; never carry standardized meaning"
      required: false
    }
  }

  invariants: [
    "Concatenation form: language[-script][-region][-variant][-extensions][-x-private] separated by hyphens",
    "Letter case is NORMATIVE (informational only): language lowercase, script Title Case, region UPPERCASE — but tag matching is case-insensitive",
    "language subtag is REQUIRED; all others are optional",
    "script subtag MUST be present when the language is conventionally written in multiple scripts (zh-Hans / zh-Hant; sr-Cyrl / sr-Latn)",
    "region 'GB' is correct (NOT 'UK'); 'CN' is mainland China (NOT Chinese language); '419' is Latin America (UN M.49 region code)",
    "Tag MUST NOT exceed 35 characters per spec (rare edge case)",
  ]

  example: {
    language: "zh",
    script: "Hans",
    region: "CN",
    variant: null,
    extension: { u: "ca-chinese-nu-hanidec" },
    "private-use": null,
    "string-form": "zh-Hans-CN-u-ca-chinese-nu-hanidec"
  }

  notes: [
    "Common tags: en (English, no region — generic), en-US (American English), en-GB (British English), zh-Hans (Simplified Chinese, no region), zh-Hans-CN (mainland), zh-Hant-TW (Traditional, Taiwan), zh-Hant-HK (Traditional, Hong Kong), pt-BR (Brazilian Portuguese), pt-PT (European Portuguese), es-419 (Latin American Spanish), ar-EG (Egyptian Arabic).",
    "JavaScript: `Intl.Locale` parses BCP 47 tags — `new Intl.Locale('zh-Hans-CN').language === 'zh'`.",
    "HTTP Accept-Language header carries weighted BCP 47 tags: `Accept-Language: en-US,en;q=0.9,zh-Hans;q=0.8`.",
    "HTML lang attribute uses BCP 47: `<html lang='ja'>`, `<p lang='ar' dir='rtl'>`. Required for assistive tech, screen reader voice selection, and CJK line-breaking (see @community/rule-cjk-line-break).",
    "BCP 47 tag matching: RFC 4647 defines basic and extended filtering — `en-*` matches en-US, en-GB; `zh` matches zh-Hans, zh-Hant.",
    "Deprecated: 'iw' (Hebrew, replaced by 'he'), 'ji' (Yiddish, replaced by 'yi'), 'in' (Indonesian, replaced by 'id'). Modern systems still accept legacy tags but emit canonical form.",
  ]

  related: [
    @community/rule-intl-api-locale-formatting,
    @community/rule-cjk-line-break,
    @community/principle-no-string-concat,
    @community/pattern-icu-message-format,
    @community/anti-pattern-flag-as-language,
    @community/fact-bidi-direction,
  ]
}
