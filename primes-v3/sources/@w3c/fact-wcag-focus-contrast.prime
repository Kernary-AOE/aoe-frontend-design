fact WcagFocusContrast {
  id: "@w3c/fact-wcag-focus-contrast"
  version: "1.0.0"

  statement: "WCAG 2.2 SC 2.4.11 (Level AA) requires that the focus indicator for a keyboard-focused UI component has a contrast ratio of ≥ 3:1 between the focused and unfocused states, and the focus indicator area must be at least as large as a 2 CSS pixel perimeter around the component."

  confidence: proven
  evidence: @w3c/source-wcag-22

  domain: accessibility

  notes: [
    "SC 2.4.11 is new in WCAG 2.2; not present in WCAG 2.1.",
    "The minimum area requirement prevents invisible 1-pixel outlines from passing.",
    "High-contrast mode in Windows OS typically satisfies this automatically.",
    "For focus rings using outline, ensure outline-offset does not create a gap between ring and component that hides the indicator.",
    "This is the evidentiary basis for @community/check-focus-visible and @community/rule-keyboard-accessible.",
  ]

  related: [
    @w3c/fact-wcag-contrast-aa,
    @community/check-focus-visible,
    @community/term-focus-ring,
  ]
}
