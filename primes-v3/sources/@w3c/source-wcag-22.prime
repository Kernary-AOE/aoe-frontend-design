source Wcag22 {
  id: "@w3c/source-wcag-22"
  version: "1.0.0"

  title: "Web Content Accessibility Guidelines (WCAG) 2.2"
  url: "https://www.w3.org/TR/WCAG22/"
  author: "W3C Web Accessibility Initiative (WAI)"
  year: 2023
  type: primary

  domain: accessibility

  description: "The W3C normative standard for web content accessibility. WCAG 2.2 was published as a W3C Recommendation on 5 October 2023. It extends WCAG 2.1 with nine new success criteria, notably SC 2.4.11 (Focus Not Obscured Minimum), SC 2.4.12 (Focus Not Obscured Enhanced), SC 2.5.7 (Dragging Movements), SC 2.5.8 (Target Size Minimum), and SC 3.3.7 (Redundant Entry)."

  relevant-sections: [
    "SC 1.4.3 — Contrast (Minimum), Level AA, 4.5:1 normal text",
    "SC 1.4.11 — Non-text Contrast, Level AA",
    "SC 2.4.7 — Focus Visible, Level AA",
    "SC 2.4.11 — Focus Not Obscured (Minimum), Level AA (new in 2.2)",
    "SC 2.5.8 — Target Size Minimum, Level AA, 24×24 CSS px (new in 2.2)",
  ]

  notes: [
    "WCAG 2.2 supersedes WCAG 2.1 for new projects. WCAG 2.1 SC 4.1.1 (Parsing) was removed in 2.2.",
    "WCAG 3.0 (Silver) is in development; do not cite WCAG 3 drafts as authoritative.",
  ]

  related: [
    @w3c/fact-wcag-contrast-aa,
    @w3c/fact-wcag-focus-contrast,
  ]
}
